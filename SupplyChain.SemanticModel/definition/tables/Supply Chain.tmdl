	/// Fast is 30 days or fewer in total, Standard 31 to 45 days, Slow above 45 days.
	column 'Fulfillment Speed'
		dataType: string
		lineageTag: 9cb01e28-76b7-4384-b6c3-924cc24ea506
		summarizeBy: none
		sourceColumn: Fulfillment Speed

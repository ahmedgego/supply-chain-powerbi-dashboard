/// One row per SKU. Holds the numeric facts and engineered features; descriptive attributes live in the dimension tables.
table 'Supply Chain'
	lineageTag: b08c8867-6793-4d40-9ded-178078cc06ea

	/// Sum of revenue generated across the SKUs in the current filter.
	measure 'Total Revenue' = SUM('Supply Chain'[Revenue])
		formatString: #,##0
		displayFolder: Revenue
		lineageTag: c02503a7-ca26-43f0-89cb-77dfb8040cff

	/// Total number of products sold.
	measure 'Total Units Sold' = SUM('Supply Chain'[Units Sold])
		formatString: #,##0
		displayFolder: Revenue
		lineageTag: 66fb70f3-3d81-4bd3-8e51-fafca7d76e26

	/// Number of SKUs in the current filter. The model grain is one row per SKU.
	measure '# SKUs' = COUNTROWS('Supply Chain')
		formatString: #,##0
		displayFolder: Revenue
		lineageTag: d4e4d264-45df-4c17-a467-a7d38c023558

	/// Simple average of the SKU list price.
	measure 'Average Price' = AVERAGE('Supply Chain'[Price])
		formatString: #,##0.00
		displayFolder: Revenue
		lineageTag: 37bbaa58-a719-42bd-b355-b4961d20c21c

	/// Revenue divided by units sold.
	measure 'Revenue per Unit' = DIVIDE([Total Revenue], [Total Units Sold])
		formatString: #,##0.00
		displayFolder: Revenue
		lineageTag: 43ffca3e-8284-480f-b1ff-6511566b4253

	/// Revenue in the current filter as a share of the whole portfolio.
	measure 'Revenue Share' = DIVIDE([Total Revenue], CALCULATE([Total Revenue], REMOVEFILTERS()))
		formatString: 0.0%
		displayFolder: Revenue
		lineageTag: 6a608675-6663-448c-953c-0298e93f1c14

	/// Defect rate in percent, weighted by production volume so large production runs count more. Use this rather than a simple average.
	measure 'Weighted Defect Rate' = DIVIDE(SUMX('Supply Chain', 'Supply Chain'[Defect Rate] * 'Supply Chain'[Production Volume]), SUM('Supply Chain'[Production Volume]))
		formatString: 0.00"%"
		displayFolder: Quality
		lineageTag: 886114cd-d3cd-461c-b8a5-7b7ddc77324c

	/// Share of SKUs whose inspection result is Fail.
	measure 'Failed Inspection Rate' = DIVIDE(CALCULATE(COUNTROWS('Supply Chain'), 'Inspection'[Inspection Result] = "Fail"), COUNTROWS('Supply Chain'))
		formatString: 0.0%
		displayFolder: Quality
		lineageTag: 70d60834-d6c0-49b6-8e17-e3a7977c427c

	/// Pearson correlation between manufacturing cost per unit and defect rate across SKUs. Near zero means cost does not explain quality.
	measure 'Cost Defect Correlation' =
			VAR _mx = AVERAGE('Supply Chain'[Manufacturing Cost per Unit])
			VAR _my = AVERAGE('Supply Chain'[Defect Rate])
			VAR _cov = SUMX('Supply Chain', ('Supply Chain'[Manufacturing Cost per Unit] - _mx) * ('Supply Chain'[Defect Rate] - _my))
			VAR _vx = SUMX('Supply Chain', ('Supply Chain'[Manufacturing Cost per Unit] - _mx) ^ 2)
			VAR _vy = SUMX('Supply Chain', ('Supply Chain'[Defect Rate] - _my) ^ 2)
			RETURN DIVIDE(_cov, SQRT(_vx * _vy), 0)
		formatString: 0.00
		displayFolder: Quality
		lineageTag: a3c663aa-4877-437f-b7bc-ebcb0f954a26

	/// Average days the supplier takes to deliver.
	measure 'Avg Supplier Lead Time' = AVERAGE('Supply Chain'[Supplier Lead Time])
		formatString: 0.0
		displayFolder: Speed
		lineageTag: 77443f98-4a5b-4299-aa36-16f25277cfad

	/// Average days spent manufacturing.
	measure 'Avg Manufacturing Lead Time' = AVERAGE('Supply Chain'[Manufacturing Lead Time])
		formatString: 0.0
		displayFolder: Speed
		lineageTag: 6e8c9b10-9cd3-4147-8a1b-fae10e875bc4

	/// Average days in transit.
	measure 'Avg Shipping Time' = AVERAGE('Supply Chain'[Shipping Time])
		formatString: 0.0
		displayFolder: Speed
		lineageTag: ff51875e-439c-4401-8ccd-27cdce67833d

	/// Average order lead time in days (source field Lead times).
	measure 'Avg Order Lead Time' = AVERAGE('Supply Chain'[Order Lead Time])
		formatString: 0.0
		displayFolder: Speed
		lineageTag: 50962a23-0817-4bab-95bc-76c7b5ec5de9

	/// Average of supplier lead time plus manufacturing lead time plus shipping time per SKU.
	measure 'Avg Fulfillment Days' = AVERAGE('Supply Chain'[Total Fulfillment Days])
		formatString: 0.0
		displayFolder: Speed
		lineageTag: dd1f84e8-6309-4543-8e15-a162baacbcd4

	/// Average shipping cost per SKU.
	measure 'Avg Shipping Cost' = AVERAGE('Supply Chain'[Shipping Cost])
		formatString: #,##0.00
		displayFolder: Cost
		lineageTag: a7b49af8-58f5-43da-915f-aa4647558ee2

	/// Average route transport cost per SKU (source field Costs).
	measure 'Avg Transport Cost' = AVERAGE('Supply Chain'[Transport Cost])
		formatString: #,##0.00
		displayFolder: Cost
		lineageTag: b05374ad-d844-4dce-b19e-d8ee9bd85cd1

	/// Shipping cost plus transport cost, summed.
	measure 'Total Logistics Cost' = SUM('Supply Chain'[Logistics Cost])
		formatString: #,##0
		displayFolder: Cost
		lineageTag: 1fcc48ac-555e-4d9b-969d-0641b17d1f25

	/// Average shipping plus transport cost per SKU.
	measure 'Avg Logistics Cost' = AVERAGE('Supply Chain'[Logistics Cost])
		formatString: #,##0.00
		displayFolder: Cost
		lineageTag: 473810df-b95e-4dad-84de-14e59b1d2b55

	/// Logistics cost as a share of revenue.
	measure 'Logistics Cost %' = DIVIDE([Total Logistics Cost], [Total Revenue])
		formatString: 0.0%
		displayFolder: Cost
		lineageTag: 007b0645-17d4-4ec5-9700-930df68432e4

	/// Average manufacturing cost per unit.
	measure 'Avg Manufacturing Cost' = AVERAGE('Supply Chain'[Manufacturing Cost per Unit])
		formatString: #,##0.00
		displayFolder: Cost
		lineageTag: 2181ca48-f6a0-40d9-9895-5315d9b667d2

	/// Manufacturing cost per unit times production volume. An estimate because the source has no total spend field.
	measure 'Estimated Manufacturing Spend' = SUMX('Supply Chain', 'Supply Chain'[Manufacturing Cost per Unit] * 'Supply Chain'[Production Volume])
		formatString: #,##0
		displayFolder: Cost
		lineageTag: 7d4ed062-c950-40cc-8fa2-d4a81cfcb277

	/// Average product availability in percent.
	measure 'Avg Availability' = AVERAGE('Supply Chain'[Availability])
		formatString: 0.0"%"
		displayFolder: Stock
		lineageTag: 3cb9ec7f-7477-4f21-a744-01c2d30f127a

	/// SKUs with 10 units or fewer in stock.
	measure 'Critical Stock SKUs' = CALCULATE(COUNTROWS('Supply Chain'), 'Supply Chain'[Stock Status] = "Critical")
		formatString: #,##0
		displayFolder: Stock
		lineageTag: c18a8585-9eaf-45e8-b116-fdfb783681cd

	/// SKUs holding less stock than their order quantity. Includes the critical-stock SKUs.
	measure 'SKUs Below Order Quantity' = COUNTROWS(FILTER('Supply Chain', 'Supply Chain'[Stock Level] < 'Supply Chain'[Order Quantity]))
		formatString: #,##0
		displayFolder: Stock
		lineageTag: 43f204f6-3723-44a5-acdc-43cd161dd6d4

	/// Total stock divided by total order quantity. Below 1 means stock does not cover orders.
	measure 'Stock Coverage Ratio' = DIVIDE(SUM('Supply Chain'[Stock Level]), SUM('Supply Chain'[Order Quantity]))
		formatString: 0.00
		displayFolder: Stock
		lineageTag: c3cd6681-4742-42b2-b38b-1993d6fc3a7e

	column 'Product Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 25c32d73-1133-4774-8cc2-dc9c05b5d132
		summarizeBy: none
		sourceColumn: Product Key


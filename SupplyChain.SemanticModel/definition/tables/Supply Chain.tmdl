		sourceColumn: Fulfillment Speed Sort

	partition 'Supply Chain' = m
		mode: import
		source =
				let
					Source = #"Source Data",
					#"Selected columns" = Table.SelectColumns(Source, {"Product Key", "Supplier Key", "Location Key", "Carrier Key", "Transport Mode Key", "Route Key", "Segment Key", "Inspection Key", "Price", "Availability", "Units Sold", "Revenue", "Stock Level", "Order Quantity", "Order Lead Time", "Shipping Time", "Shipping Cost", "Supplier Lead Time", "Production Volume", "Manufacturing Lead Time", "Manufacturing Cost per Unit", "Defect Rate", "Transport Cost"}),
					// Total days from supplier order to delivery
					#"Added fulfillment days" = Table.AddColumn(#"Selected columns", "Total Fulfillment Days", each [Supplier Lead Time] + [Manufacturing Lead Time] + [Shipping Time], Int64.Type),
					#"Added logistics cost" = Table.AddColumn(#"Added fulfillment days", "Logistics Cost", each [Shipping Cost] + [Transport Cost], type number),
					// Stock risk class: critical at 10 units or less, reorder when stock is below the order quantity
					#"Added stock status" = Table.AddColumn(#"Added logistics cost", "Stock Status", each if [Stock Level] <= 10 then "Critical" else if [Stock Level] < [Order Quantity] then "Reorder" else "Healthy", type text),
					#"Added stock status sort" = Table.AddColumn(#"Added stock status", "Stock Status Sort", each if [Stock Status] = "Critical" then 1 else if [Stock Status] = "Reorder" then 2 else 3, Int64.Type),
					#"Added defect band" = Table.AddColumn(#"Added stock status sort", "Defect Band", each if [Defect Rate] < 1.5 then "Low" else if [Defect Rate] < 3 then "Medium" else "High", type text),
					#"Added defect band sort" = Table.AddColumn(#"Added defect band", "Defect Band Sort", each if [Defect Band] = "Low" then 1 else if [Defect Band] = "Medium" then 2 else 3, Int64.Type),
					#"Added fulfillment speed" = Table.AddColumn(#"Added defect band sort", "Fulfillment Speed", each if [Total Fulfillment Days] <= 30 then "Fast" else if [Total Fulfillment Days] <= 45 then "Standard" else "Slow", type text),
					#"Added fulfillment speed sort" = Table.AddColumn(#"Added fulfillment speed", "Fulfillment Speed Sort", each if [Fulfillment Speed] = "Fast" then 1 else if [Fulfillment Speed] = "Standard" then 2 else 3, Int64.Type)
				in
					#"Added fulfillment speed sort"


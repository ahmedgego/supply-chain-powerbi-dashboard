			VAR _c2 = IF(ISFILTERED('Supplier'[Supplier]), "<span class='chip'><b>" & "Supplier" & "</b>" & CONCATENATEX(VALUES('Supplier'[Supplier]), 'Supplier'[Supplier], ", ", 'Supplier'[Supplier], ASC) & "</span>", "")
			VAR _c3 = IF(ISFILTERED('Location'[City]), "<span class='chip'><b>" & "City" & "</b>" & CONCATENATEX(VALUES('Location'[City]), 'Location'[City], ", ", 'Location'[City], ASC) & "</span>", "")
			VAR _c4 = IF(ISFILTERED('Transport Mode'[Transport Mode]), "<span class='chip'><b>" & "Mode" & "</b>" & CONCATENATEX(VALUES('Transport Mode'[Transport Mode]), 'Transport Mode'[Transport Mode], ", ", 'Transport Mode'[Transport Mode], ASC) & "</span>", "")
			VAR _chips = _c1 & _c2 & _c3 & _c4
			RETURN
			[HTML Head] & "<div class='ph'><div><h1>Revenue, stock and quality at a glance</h1><p>Portfolio summary across every supplier, location and product type</p></div><div class='chips'>" & IF(_chips = "", "<span class='chip all'>All data</span>", _chips) & "</div></div>"
		displayFolder: Visuals

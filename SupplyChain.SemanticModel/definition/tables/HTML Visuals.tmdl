	/// Message shown by an HTML visual when no SKU matches the current filters.
	measure 'HTML Empty' = [HTML Head] & "<div class='empty'>No SKUs match the current filters. Use Reset to clear them.</div>"
		displayFolder: Shared
		lineageTag: 02229af9-438e-4bbb-ae67-6a6d55bb582e

	/// HTML for the Canvas visual. Bind it to the HTML Content custom visual.
	measure 'HTML Canvas' = [HTML Head] & "<div class='cv'><div class='glow g1'></div><div class='glow g2'></div></div>"
		displayFolder: Visuals
		lineageTag: 80c844b4-4234-4401-9fb4-286c45fd0725


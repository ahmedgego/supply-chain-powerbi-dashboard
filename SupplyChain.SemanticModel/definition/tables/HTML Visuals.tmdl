	/// HTML for the Header Narrative visual. Bind it to the HTML Content custom visual.
	measure 'HTML Header Narrative' =
			VAR _c1 = IF(ISFILTERED('Product'[Product Type]), "<span class='chip'><b>" & "Product" & "</b>" & CONCATENATEX(VALUES('Product'[Product Type]), 'Product'[Product Type], ", ", 'Product'[Product Type], ASC) & "</span>", "")
			VAR _c2 = IF(ISFILTERED('Supplier'[Supplier]), "<span class='chip'><b>" & "Supplier" & "</b>" & CONCATENATEX(VALUES('Supplier'[Supplier]), 'Supplier'[Supplier], ", ", 'Supplier'[Supplier], ASC) & "</span>", "")
			VAR _c3 = IF(ISFILTERED('Location'[City]), "<span class='chip'><b>" & "City" & "</b>" & CONCATENATEX(VALUES('Location'[City]), 'Location'[City], ", ", 'Location'[City], ASC) & "</span>", "")
			VAR _c4 = IF(ISFILTERED('Transport Mode'[Transport Mode]), "<span class='chip'><b>" & "Mode" & "</b>" & CONCATENATEX(VALUES('Transport Mode'[Transport Mode]), 'Transport Mode'[Transport Mode], ", ", 'Transport Mode'[Transport Mode], ASC) & "</span>", "")
			VAR _chips = _c1 & _c2 & _c3 & _c4
			RETURN
			[HTML Head] & "<div class='ph'><div><h1>What does the data say?</h1><p>Plain-language summary that rewrites itself when you filter or select</p></div><div class='chips'>" & IF(_chips = "", "<span class='chip all'>All data</span>", _chips) & "</div></div>"
		displayFolder: Visuals
		lineageTag: 44f3a6f8-1973-495c-879d-7989fc89bc9c

	/// HTML for the Header Overview visual. Bind it to the HTML Content custom visual.
	measure 'HTML Header Overview' =

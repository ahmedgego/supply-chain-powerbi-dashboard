	/// HTML for the KPI Strip Overview visual. Bind it to the HTML Content custom visual.
	measure 'HTML KPI Strip Overview' =
			VAR _n = [# SKUs]
			VAR _v1 = COALESCE([Total Revenue], 0)
			VAR _b1 = COALESCE(CALCULATE([Total Revenue], REMOVEFILTERS()), 0)
			VAR _v2 = COALESCE([Total Units Sold], 0)
			VAR _b2 = COALESCE(CALCULATE([Total Units Sold], REMOVEFILTERS()), 0)
			VAR _v3 = COALESCE([Weighted Defect Rate], 0)
			VAR _b3 = COALESCE(CALCULATE([Weighted Defect Rate], REMOVEFILTERS()), 0)
			VAR _d3 = DIVIDE(_v3 - _b3, _b3, 0)
			VAR _v4 = COALESCE([Avg Fulfillment Days], 0)
			VAR _b4 = COALESCE(CALCULATE([Avg Fulfillment Days], REMOVEFILTERS()), 0)
			VAR _d4 = DIVIDE(_v4 - _b4, _b4, 0)
			VAR _v5 = COALESCE([Logistics Cost %], 0)
			VAR _b5 = COALESCE(CALCULATE([Logistics Cost %], REMOVEFILTERS()), 0)
			VAR _d5 = DIVIDE(_v5 - _b5, _b5, 0)
			VAR _v6 = COALESCE([Critical Stock SKUs], 0)
			VAR _b6 = COALESCE(CALCULATE([Critical Stock SKUs], REMOVEFILTERS()), 0)
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='kpis'>" & "<div class='kpi' style='--ac:var(--" & "rev" & ");--d:" & "0.07" & "s'><div class='kl'>" & "Total revenue" & "</div><div class='kv'>" & IF(_v1 >= 1000000, FORMAT(_v1 / 1000000, "0.00", "en-US"), FORMAT(_v1 / 1000, "#,##0.0", "en-US")) & "<span class='ku'>" & IF(_v1 >= 1000000, "M", "K") & "</span></div><div class='kd " & "neu" & "'><span>" & "●" & "</span><span>" & FORMAT(DIVIDE(_v1, _b1, 0), "0.0%", "en-US") & " of portfolio" & "</span></div><div class='kb'><div class='fill' style='width:" & FORMAT(DIVIDE(_v1, _b1, 0) * 100, "0.0", "en-US") & "%;--d:" & "0.07" & "s'></div><u style='left:" & "100" & "%'></u></div></div>" & "<div class='kpi' style='--ac:var(--" & "units" & ");--d:" & "0.14" & "s'><div class='kl'>" & "Units sold" & "</div><div class='kv'>" & FORMAT(_v2, "#,##0", "en-US") & "<span class='ku'>" & "" & "</span></div><div class='kd " & "neu" & "'><span>" & "●" & "</span><span>" & FORMAT(DIVIDE(_v2, _b2, 0), "0.0%", "en-US") & " of portfolio" & "</span></div><div class='kb'><div class='fill' style='width:" & FORMAT(DIVIDE(_v2, _b2, 0) * 100, "0.0", "en-US") & "%;--d:" & "0.14" & "s'></div><u style='left:" & "100" & "%'></u></div></div>" & "<div class='kpi' style='--ac:var(--" & "defect" & ");--d:" & "0.21" & "s'><div class='kl'>" & "Defect rate" & "</div><div class='kv'>" & FORMAT(_v3, "0.00", "en-US") & "<span class='ku'>" & "%" & "</span></div><div class='kd " & IF(ABS(_d3) < 0.0005, "neu", IF((_d3 < 0) = TRUE(), "good", "bad")) & "'><span>" & IF(ABS(_d3) < 0.0005, "●", IF(_d3 > 0, "▲", "▼")) & "</span><span>" & IF(ABS(_d3) < 0.0005, "At portfolio level", FORMAT(ABS(_d3), "0.0%", "en-US") & IF(_d3 > 0, " above", " below") & " portfolio") & "</span></div><div class='kb'><div class='fill' style='width:" & FORMAT(MIN(100, DIVIDE(_v3, _b3 * 2, 0) * 100), "0.0", "en-US") & "%;--d:" & "0.21" & "s'></div><u style='left:" & "50" & "%'></u></div></div>" & "<div class='kpi' style='--ac:var(--" & "time" & ");--d:" & "0.28" & "s'><div class='kl'>" & "Fulfillment time" & "</div><div class='kv'>" & FORMAT(_v4, "0.0", "en-US") & "<span class='ku'>" & " days" & "</span></div><div class='kd " & IF(ABS(_d4) < 0.0005, "neu", IF((_d4 < 0) = TRUE(), "good", "bad")) & "'><span>" & IF(ABS(_d4) < 0.0005, "●", IF(_d4 > 0, "▲", "▼")) & "</span><span>" & IF(ABS(_d4) < 0.0005, "At portfolio level", FORMAT(ABS(_d4), "0.0%", "en-US") & IF(_d4 > 0, " above", " below") & " portfolio") & "</span></div><div class='kb'><div class='fill' style='width:" & FORMAT(MIN(100, DIVIDE(_v4, _b4 * 2, 0) * 100), "0.0", "en-US") & "%;--d:" & "0.28" & "s'></div><u style='left:" & "50" & "%'></u></div></div>" & "<div class='kpi' style='--ac:var(--" & "cost" & ");--d:" & "0.35" & "s'><div class='kl'>" & "Logistics cost / revenue" & "</div><div class='kv'>" & FORMAT(_v5 * 100, "0.0", "en-US") & "<span class='ku'>" & "%" & "</span></div><div class='kd " & IF(ABS(_d5) < 0.0005, "neu", IF((_d5 < 0) = TRUE(), "good", "bad")) & "'><span>" & IF(ABS(_d5) < 0.0005, "●", IF(_d5 > 0, "▲", "▼")) & "</span><span>" & IF(ABS(_d5) < 0.0005, "At portfolio level", FORMAT(ABS(_d5), "0.0%", "en-US") & IF(_d5 > 0, " above", " below") & " portfolio") & "</span></div><div class='kb'><div class='fill' style='width:" & FORMAT(MIN(100, DIVIDE(_v5, _b5 * 2, 0) * 100), "0.0", "en-US") & "%;--d:" & "0.35" & "s'></div><u style='left:" & "50" & "%'></u></div></div>" & "<div class='kpi' style='--ac:var(--" & "risk" & ");--d:" & "0.42" & "s'><div class='kl'>" & "Critical-stock SKUs" & "</div><div class='kv'>" & FORMAT(_v6, "0", "en-US") & "<span class='ku'>" & IF(_v6 = 1, " SKU", " SKUs") & "</span></div><div class='kd " & IF(_v6 > 0, "bad", "good") & "'><span>" & IF(_v6 > 0, "▲", "●") & "</span><span>" & FORMAT(_v6, "0", "en-US") & " of " & FORMAT(_n, "0", "en-US") & " SKUs in view" & "</span></div><div class='kb'><div class='fill' style='width:" & FORMAT(DIVIDE(_v6, _n, 0) * 100, "0.0", "en-US") & "%;--d:" & "0.42" & "s'></div><u style='left:" & "100" & "%'></u></div></div>" & "</div>")
		displayFolder: Visuals
		lineageTag: 15046589-bab7-4e8a-845f-05d624630915

	/// HTML for the KPI Strip Logistics visual. Bind it to the HTML Content custom visual.
	measure 'HTML KPI Strip Logistics' =
			VAR _n = [# SKUs]
			VAR _v1 = COALESCE([Avg Shipping Time], 0)
			VAR _b1 = COALESCE(CALCULATE([Avg Shipping Time], REMOVEFILTERS()), 0)
			VAR _d1 = DIVIDE(_v1 - _b1, _b1, 0)
			VAR _v2 = COALESCE([Avg Shipping Cost], 0)
			VAR _b2 = COALESCE(CALCULATE([Avg Shipping Cost], REMOVEFILTERS()), 0)
			VAR _d2 = DIVIDE(_v2 - _b2, _b2, 0)
			VAR _v3 = COALESCE([Avg Transport Cost], 0)
			VAR _b3 = COALESCE(CALCULATE([Avg Transport Cost], REMOVEFILTERS()), 0)
			VAR _d3 = DIVIDE(_v3 - _b3, _b3, 0)
			VAR _v4 = COALESCE([Avg Availability], 0)
			VAR _b4 = COALESCE(CALCULATE([Avg Availability], REMOVEFILTERS()), 0)
			VAR _d4 = DIVIDE(_v4 - _b4, _b4, 0)
			VAR _v5 = COALESCE([SKUs Below Order Quantity], 0)
			VAR _b5 = COALESCE(CALCULATE([SKUs Below Order Quantity], REMOVEFILTERS()), 0)
			VAR _v6 = COALESCE([Critical Stock SKUs], 0)
			VAR _b6 = COALESCE(CALCULATE([Critical Stock SKUs], REMOVEFILTERS()), 0)
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='kpis'>" & "<div class='kpi' style='--ac:var(--" & "time" & ");--d:" & "0.07" & "s'><div class='kl'>" & "Shipping time" & "</div><div class='kv'>" & FORMAT(_v1, "0.0", "en-US") & "<span class='ku'>" & " days" & "</span></div><div class='kd " & IF(ABS(_d1) < 0.0005, "neu", IF((_d1 < 0) = TRUE(), "good", "bad")) & "'><span>" & IF(ABS(_d1) < 0.0005, "●", IF(_d1 > 0, "▲", "▼")) & "</span><span>" & IF(ABS(_d1) < 0.0005, "At portfolio level", FORMAT(ABS(_d1), "0.0%", "en-US") & IF(_d1 > 0, " above", " below") & " portfolio") & "</span></div><div class='kb'><div class='fill' style='width:" & FORMAT(MIN(100, DIVIDE(_v1, _b1 * 2, 0) * 100), "0.0", "en-US") & "%;--d:" & "0.07" & "s'></div><u style='left:" & "50" & "%'></u></div></div>" & "<div class='kpi' style='--ac:var(--" & "cost" & ");--d:" & "0.14" & "s'><div class='kl'>" & "Shipping cost / SKU" & "</div><div class='kv'>" & FORMAT(_v2, "0.00", "en-US") & "<span class='ku'>" & "" & "</span></div><div class='kd " & IF(ABS(_d2) < 0.0005, "neu", IF((_d2 < 0) = TRUE(), "good", "bad")) & "'><span>" & IF(ABS(_d2) < 0.0005, "●", IF(_d2 > 0, "▲", "▼")) & "</span><span>" & IF(ABS(_d2) < 0.0005, "At portfolio level", FORMAT(ABS(_d2), "0.0%", "en-US") & IF(_d2 > 0, " above", " below") & " portfolio") & "</span></div><div class='kb'><div class='fill' style='width:" & FORMAT(MIN(100, DIVIDE(_v2, _b2 * 2, 0) * 100), "0.0", "en-US") & "%;--d:" & "0.14" & "s'></div><u style='left:" & "50" & "%'></u></div></div>" & "<div class='kpi' style='--ac:var(--" & "cost" & ");--d:" & "0.21" & "s'><div class='kl'>" & "Transport cost / SKU" & "</div><div class='kv'>" & FORMAT(_v3, "#,##0", "en-US") & "<span class='ku'>" & "" & "</span></div><div class='kd " & IF(ABS(_d3) < 0.0005, "neu", IF((_d3 < 0) = TRUE(), "good", "bad")) & "'><span>" & IF(ABS(_d3) < 0.0005, "●", IF(_d3 > 0, "▲", "▼")) & "</span><span>" & IF(ABS(_d3) < 0.0005, "At portfolio level", FORMAT(ABS(_d3), "0.0%", "en-US") & IF(_d3 > 0, " above", " below") & " portfolio") & "</span></div><div class='kb'><div class='fill' style='width:" & FORMAT(MIN(100, DIVIDE(_v3, _b3 * 2, 0) * 100), "0.0", "en-US") & "%;--d:" & "0.21" & "s'></div><u style='left:" & "50" & "%'></u></div></div>" & "<div class='kpi' style='--ac:var(--" & "units" & ");--d:" & "0.28" & "s'><div class='kl'>" & "Availability" & "</div><div class='kv'>" & FORMAT(_v4, "0.0", "en-US") & "<span class='ku'>" & "%" & "</span></div><div class='kd " & IF(ABS(_d4) < 0.0005, "neu", IF((_d4 < 0) = FALSE(), "good", "bad")) & "'><span>" & IF(ABS(_d4) < 0.0005, "●", IF(_d4 > 0, "▲", "▼")) & "</span><span>" & IF(ABS(_d4) < 0.0005, "At portfolio level", FORMAT(ABS(_d4), "0.0%", "en-US") & IF(_d4 > 0, " above", " below") & " portfolio") & "</span></div><div class='kb'><div class='fill' style='width:" & FORMAT(MIN(100, DIVIDE(_v4, _b4 * 2, 0) * 100), "0.0", "en-US") & "%;--d:" & "0.28" & "s'></div><u style='left:" & "50" & "%'></u></div></div>" & "<div class='kpi' style='--ac:var(--" & "defect" & ");--d:" & "0.35" & "s'><div class='kl'>" & "SKUs below order qty" & "</div><div class='kv'>" & FORMAT(_v5, "0", "en-US") & "<span class='ku'>" & IF(_v5 = 1, " SKU", " SKUs") & "</span></div><div class='kd " & IF(_v5 > 0, "bad", "good") & "'><span>" & IF(_v5 > 0, "▲", "●") & "</span><span>" & FORMAT(_v5, "0", "en-US") & " of " & FORMAT(_n, "0", "en-US") & " SKUs in view" & "</span></div><div class='kb'><div class='fill' style='width:" & FORMAT(DIVIDE(_v5, _n, 0) * 100, "0.0", "en-US") & "%;--d:" & "0.35" & "s'></div><u style='left:" & "100" & "%'></u></div></div>" & "<div class='kpi' style='--ac:var(--" & "risk" & ");--d:" & "0.42" & "s'><div class='kl'>" & "Critical-stock SKUs" & "</div><div class='kv'>" & FORMAT(_v6, "0", "en-US") & "<span class='ku'>" & IF(_v6 = 1, " SKU", " SKUs") & "</span></div><div class='kd " & IF(_v6 > 0, "bad", "good") & "'><span>" & IF(_v6 > 0, "▲", "●") & "</span><span>" & FORMAT(_v6, "0", "en-US") & " of " & FORMAT(_n, "0", "en-US") & " SKUs in view" & "</span></div><div class='kb'><div class='fill' style='width:" & FORMAT(DIVIDE(_v6, _n, 0) * 100, "0.0", "en-US") & "%;--d:" & "0.42" & "s'></div><u style='left:" & "100" & "%'></u></div></div>" & "</div>")
		displayFolder: Visuals
		lineageTag: 22965261-0e15-4c5d-be03-985c87763d22

	/// HTML for the Revenue Mix Donut visual. Bind it to the HTML Content custom visual.
	measure 'HTML Revenue Mix Donut' =
			VAR _n = [# SKUs]
			VAR _t = ADDCOLUMNS(VALUES('Product'[Product Type]), "x_rev", [Total Revenue], "x_ord", CALCULATE(MAX('Product'[Product Type Order])))
			VAR _tot = SUMX(_t, [x_rev])
			VAR _r = ADDCOLUMNS(_t, "x_cum", VAR _o = [x_ord] RETURN SUMX(FILTER(_t, [x_ord] < _o), [x_rev]))
			VAR _C = 502.6548
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Revenue mix by product type" & "</div><div class='sub'>" & "share of revenue in view" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='donut'><svg viewBox='0 0 220 220'><circle cx='110' cy='110' r='80' fill='none' stroke='var(--surface2)' stroke-width='26'></circle>" & CONCATENATEX(_r, "<circle class='seg' cx='110' cy='110' r='80' fill='none' stroke='var(--c" & [x_ord] & ")' stroke-width='26' stroke-dasharray='" & FORMAT(MAX(0, DIVIDE([x_rev], _tot, 0) * _C - 2), "0.00", "en-US") & " " & FORMAT(_C - MAX(0, DIVIDE([x_rev], _tot, 0) * _C - 2), "0.00", "en-US") & "' stroke-dashoffset='" & FORMAT(-DIVIDE([x_cum], _tot, 0) * _C, "0.00", "en-US") & "' transform='rotate(-90 110 110)' style='--d:" & FORMAT([x_ord] * 0.12, "0.00", "en-US") & "s'><title>" & 'Product'[Product Type] & " · " & IF([x_rev] >= 1000000, FORMAT([x_rev] / 1000000, "0.00", "en-US") & "M", FORMAT([x_rev] / 1000, "#,##0.0", "en-US") & "K") & " · " & FORMAT(DIVIDE([x_rev], _tot, 0), "0.0%", "en-US") & " of revenue</title></circle>", "", [x_ord], ASC) & "</svg><div class='dc'><b>" & IF(_tot >= 1000000, FORMAT(_tot / 1000000, "0.00", "en-US") & "M", FORMAT(_tot / 1000, "#,##0.0", "en-US") & "K") & "</b><span>total revenue</span></div></div><div class='list'>" & CONCATENATEX(_r, "<div class='lg rise' style='--d:" & FORMAT([x_ord] * 0.1 + 0.2, "0.00", "en-US") & "s'><i class='sw' style='background:var(--c" & [x_ord] & ")'></i><span class='ln'>" & 'Product'[Product Type] & "</span><span class='lv'>" & IF([x_rev] >= 1000000, FORMAT([x_rev] / 1000000, "0.00", "en-US") & "M", FORMAT([x_rev] / 1000, "#,##0.0", "en-US") & "K") & "</span><span class='lp'>" & FORMAT(DIVIDE([x_rev], _tot, 0), "0.0%", "en-US") & "</span></div>", "", [x_rev], DESC) & "</div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: 17d9aec9-c26d-464c-b0ff-d25ccb03dfba

	/// HTML for the Location Bubbles visual. Bind it to the HTML Content custom visual.
	measure 'HTML Location Bubbles' =
			VAR _n = [# SKUs]
			VAR _t = ADDCOLUMNS(VALUES('Location'[City]), "x_rev", [Total Revenue], "x_lt", [Avg Supplier Lead Time], "x_x", CALCULATE(MAX('Location'[Map X])), "x_y", CALCULATE(MAX('Location'[Map Y])), "x_s", CALCULATE(MAX('Location'[Label Side])))
			VAR _maxRev = MAXX(_t, [x_rev])
			VAR _maxLt = MAXX(_t, [x_lt])
			VAR _minLt = MINX(_t, [x_lt])
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Revenue and lead time by location" & "</div><div class='sub'>" & "where the money sits and how long suppliers take" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='map'><svg viewBox='0 0 400 330' preserveAspectRatio='xMidYMid meet'><defs><pattern id='dg' width='20' height='20' patternUnits='userSpaceOnUse'><circle cx='2' cy='2' r='1.2' fill='var(--line)'></circle></pattern></defs><rect x='0' y='0' width='400' height='330' fill='url(#dg)'></rect>" & CONCATENATEX(_t, "<g><circle class='ring' cx='" & FORMAT((40 + [x_x] * 320 + [x_s] * 10), "0.0", "en-US") & "' cy='" & FORMAT((30 + [x_y] * 250), "0.0", "en-US") & "' r='" & FORMAT((9 + 15 * SQRT(DIVIDE([x_rev], _maxRev, 0))), "0.0", "en-US") & "' fill='none' stroke='var(--rev)' stroke-width='2' style='--d:" & FORMAT(RANKX(_t, [x_rev], , DESC) * 0.12, "0.00", "en-US") & "s'></circle><circle class='dot' cx='" & FORMAT((40 + [x_x] * 320 + [x_s] * 10), "0.0", "en-US") & "' cy='" & FORMAT((30 + [x_y] * 250), "0.0", "en-US") & "' r='" & FORMAT((9 + 15 * SQRT(DIVIDE([x_rev], _maxRev, 0))), "0.0", "en-US") & "' fill='var(--rev)' fill-opacity='" & FORMAT(0.45 + 0.5 * DIVIDE([x_lt] - _minLt, _maxLt - _minLt, 0.5), "0.00", "en-US") & "' stroke='var(--surface)' stroke-width='2' style='--d:" & FORMAT(RANKX(_t, [x_rev], , DESC) * 0.12, "0.00", "en-US") & "s'></circle><text class='mt' x='" & FORMAT((40 + [x_x] * 320 + [x_s] * 10) + [x_s] * ((9 + 15 * SQRT(DIVIDE([x_rev], _maxRev, 0))) + 8), "0.0", "en-US") & "' y='" & FORMAT((30 + [x_y] * 250) - 1, "0.0", "en-US") & "' text-anchor='" & IF([x_s] > 0, "start", "end") & "'>" & 'Location'[City] & "</text><text class='ms' x='" & FORMAT((40 + [x_x] * 320 + [x_s] * 10) + [x_s] * ((9 + 15 * SQRT(DIVIDE([x_rev], _maxRev, 0))) + 8), "0.0", "en-US") & "' y='" & FORMAT((30 + [x_y] * 250) + 13, "0.0", "en-US") & "' text-anchor='" & IF([x_s] > 0, "start", "end") & "'>" & IF([x_rev] >= 1000000, FORMAT([x_rev] / 1000000, "0.00", "en-US") & "M", FORMAT([x_rev] / 1000, "#,##0.0", "en-US") & "K") & " · " & FORMAT([x_lt], "0.0", "en-US") & " d lead</text></g>", "") & "<text class='ms' x='398' y='326' text-anchor='end'>Schematic map, not to scale · bubble = revenue · opacity = lead time</text></svg></div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: 099496fa-1837-4ccb-8d76-c11dfc114e18

	/// HTML for the Key Insights visual. Bind it to the HTML Content custom visual.
	measure 'HTML Key Insights' =
			VAR _n = [# SKUs]
			VAR _p = ADDCOLUMNS(VALUES('Product'[Product Type]), "x_v", [Total Revenue])
			VAR _pTop = TOPN(1, _p, [x_v], DESC)
			VAR _pName = MAXX(_pTop, 'Product'[Product Type])
			VAR _pVal = MAXX(_pTop, [x_v])
			VAR _tot = SUMX(_p, [x_v])
			VAR _s = ADDCOLUMNS(VALUES('Supplier'[Supplier]), "x_d", [Weighted Defect Rate])
			VAR _sBest = TOPN(1, _s, [x_d], ASC)
			VAR _sWorst = TOPN(1, _s, [x_d], DESC)
			VAR _baseD = CALCULATE([Weighted Defect Rate], REMOVEFILTERS())
			VAR _l = ADDCOLUMNS(VALUES('Location'[City]), "x_l", [Avg Supplier Lead Time])
			VAR _lTop = TOPN(1, _l, [x_l], DESC)
			VAR _baseL = CALCULATE([Avg Supplier Lead Time], REMOVEFILTERS())
			VAR _crit = [Critical Stock SKUs]
			VAR _below = [SKUs Below Order Quantity]
			VAR _aN = CALCULATE(COUNTROWS('Supply Chain'), 'Product'[ABC Class] = "A")
			VAR _aRev = CALCULATE([Total Revenue], 'Product'[ABC Class] = "A")
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Key insights" & "</div><div class='sub'>" & "updates with your filters" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='list' style='justify-content:flex-start'>" & "<div class='ins' style='--ac:var(--" & "c1" & ");--d:" & "0.10" & "s'><div class='ib'>" & "★" & "</div><div class='it'>" & "<b>" & _pName & "</b> leads revenue" & "<small>" & IF(_pVal >= 1000000, FORMAT(_pVal / 1000000, "0.00", "en-US") & "M", FORMAT(_pVal / 1000, "#,##0.0", "en-US") & "K") & " · " & FORMAT(DIVIDE(_pVal, _tot, 0), "0.0%", "en-US") & " of revenue in view" & "</small></div></div>" & "<div class='ins' style='--ac:var(--" & "good" & ");--d:" & "0.20" & "s'><div class='ib'>" & "✓" & "</div><div class='it'>" & "<b>" & MAXX(_sBest, 'Supplier'[Supplier]) & "</b> has the lowest defect rate" & "<small>" & FORMAT(MAXX(_sBest, [x_d]), "0.00", "en-US") & "% vs " & FORMAT(_baseD, "0.00", "en-US") & "% portfolio" & "</small></div></div>" & "<div class='ins' style='--ac:var(--" & "defect" & ");--d:" & "0.30" & "s'><div class='ib'>" & "✕" & "</div><div class='it'>" & "<b>" & MAXX(_sWorst, 'Supplier'[Supplier]) & "</b> has the highest defect rate" & "<small>" & FORMAT(MAXX(_sWorst, [x_d]), "0.00", "en-US") & "% vs " & FORMAT(_baseD, "0.00", "en-US") & "% portfolio" & "</small></div></div>" & "<div class='ins' style='--ac:var(--" & "time" & ");--d:" & "0.40" & "s'><div class='ib'>" & "◆" & "</div><div class='it'>" & "<b>" & MAXX(_lTop, 'Location'[City]) & "</b> waits longest on suppliers" & "<small>" & FORMAT(MAXX(_lTop, [x_l]), "0.0", "en-US") & " days supplier lead time vs " & FORMAT(_baseL, "0.0", "en-US") & " portfolio" & "</small></div></div>" & "<div class='ins' style='--ac:var(--" & "risk" & ");--d:" & "0.50" & "s'><div class='ib'>" & "!" & "</div><div class='it'>" & "<b>" & FORMAT(_crit, "0", "en-US") & IF(_crit = 1, " SKU", " SKUs") & "</b> " & IF(_crit = 1, "is", "are") & " critically low on stock" & "<small>" & FORMAT(_below, "0", "en-US") & " SKUs hold less stock than their order quantity" & "</small></div></div>" & "<div class='ins' style='--ac:var(--" & "c4" & ");--d:" & "0.60" & "s'><div class='ib'>" & "▲" & "</div><div class='it'>" & "<b>" & FORMAT(_aN, "0", "en-US") & " A-class" & IF(_aN = 1, " SKU", " SKUs") & "</b> " & IF(_aN = 1, "drives", "drive") & " most of the revenue" & "<small>" & FORMAT(DIVIDE(_aRev, _tot, 0) * 100, "0", "en-US") & "% of revenue in view (A = first 70% of portfolio revenue)" & "</small></div></div>" & "</div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: 55b53199-1caf-45bb-9e9c-75f69c4555d2

	/// HTML for the Supplier Revenue Bars visual. Bind it to the HTML Content custom visual.
	measure 'HTML Supplier Revenue Bars' =
			VAR _n = [# SKUs]
			VAR _s = ADDCOLUMNS(VALUES('Supplier'[Supplier]), "x_rev", [Total Revenue])
			VAR _max = MAXX(_s, [x_rev])
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Revenue by supplier" & "</div><div class='sub'>" & "stacked by product type" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='list'><div class='keys' style='margin-bottom:4px'>" & CONCATENATEX(VALUES('Product'[Product Type]), "<span><i class='sw' style='background:var(--c" & CALCULATE(MAX('Product'[Product Type Order])) & ")'></i>" & 'Product'[Product Type] & "</span>", "", CALCULATE(MAX('Product'[Product Type Order])), ASC) & "</div>" & CONCATENATEX(_s, "<div class='hb'><div class='nm'>" & 'Supplier'[Supplier] & "</div><div class='tr'><div class='st' style='width:" & FORMAT(DIVIDE([x_rev], _max, 0) * 100, "0.0", "en-US") & "%;--d:" & FORMAT(RANKX(_s, [x_rev], , DESC) * 0.08, "0.00", "en-US") & "s'>" & CONCATENATEX(VALUES('Product'[Product Type]), "<i class='k" & CALCULATE(MAX('Product'[Product Type Order])) & "' title='" & 'Supplier'[Supplier] & " · " & 'Product'[Product Type] & " · " & IF([Total Revenue] >= 1000000, FORMAT([Total Revenue] / 1000000, "0.00", "en-US") & "M", FORMAT([Total Revenue] / 1000, "#,##0.0", "en-US") & "K") & " (" & FORMAT(DIVIDE([Total Revenue], CALCULATE([Total Revenue], REMOVEFILTERS('Product')), 0), "0%", "en-US") & " of supplier)' style='flex:" & FORMAT([Total Revenue], "0.00", "en-US") & "'><em>" & IF(DIVIDE([Total Revenue], CALCULATE([Total Revenue], REMOVEFILTERS('Product')), 0) >= 0.12, IF([Total Revenue] >= 1000000, FORMAT([Total Revenue] / 1000000, "0.00", "en-US") & "M", FORMAT([Total Revenue] / 1000, "#,##0.0", "en-US") & "K"), "") & "</em></i>", "", CALCULATE(MAX('Product'[Product Type Order])), ASC) & "</div></div><div class='vl'>" & IF([x_rev] >= 1000000, FORMAT([x_rev] / 1000000, "0.00", "en-US") & "M", FORMAT([x_rev] / 1000, "#,##0.0", "en-US") & "K") & "</div></div>", "", [x_rev], DESC) & "</div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: 974e08dd-b1ec-405b-9d9c-efc9f5a7f4fd

	/// HTML for the Segment Revenue Bars visual. Bind it to the HTML Content custom visual.
	measure 'HTML Segment Revenue Bars' =
			VAR _n = [# SKUs]
			VAR _s = ADDCOLUMNS(VALUES('Customer Segment'[Customer Segment]), "x_rev", [Total Revenue])
			VAR _max = MAXX(_s, [x_rev])
			VAR _tot = SUMX(_s, [x_rev])
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Revenue by customer segment" & "</div><div class='sub'>" & "who buys" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='list'>" & CONCATENATEX(_s, "<div class='hb big' style='grid-template-columns:110px 1fr'><div class='nm'>" & 'Customer Segment'[Customer Segment] & "</div><div class='tr'><div class='st' style='width:" & FORMAT(DIVIDE([x_rev], _max, 0) * 100, "0.0", "en-US") & "%;--d:" & FORMAT(RANKX(_s, [x_rev], , DESC) * 0.08, "0.00", "en-US") & "s'><i class='s3' style='flex:1' title='" & 'Customer Segment'[Customer Segment] & " · " & IF([x_rev] >= 1000000, FORMAT([x_rev] / 1000000, "0.00", "en-US") & "M", FORMAT([x_rev] / 1000, "#,##0.0", "en-US") & "K") & " revenue · " & FORMAT(DIVIDE([x_rev], _tot, 0), "0%", "en-US") & " of total'><em>" & IF([x_rev] >= 1000000, FORMAT([x_rev] / 1000000, "0.00", "en-US") & "M", FORMAT([x_rev] / 1000, "#,##0.0", "en-US") & "K") & " · " & FORMAT(DIVIDE([x_rev], _tot, 0), "0%", "en-US") & "</em></i></div></div></div>", "", [x_rev], DESC) & "</div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: d46136fc-6ec9-4e19-a8eb-fccdb0667d34

	/// HTML for the Rail Narrative visual. Bind it to the HTML Content custom visual.
	measure 'HTML Rail Narrative' =
			VAR _n = IF(ISFILTERED('Product'[Product Type]), 1, 0) + IF(ISFILTERED('Supplier'[Supplier]), 1, 0) + IF(ISFILTERED('Location'[City]), 1, 0) + IF(ISFILTERED('Transport Mode'[Transport Mode]), 1, 0)
			RETURN

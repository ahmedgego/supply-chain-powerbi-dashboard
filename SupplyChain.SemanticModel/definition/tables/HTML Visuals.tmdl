	measure 'HTML Intro' = [HTML Head] & "<div class='in'><div class='glow g1'></div><div class='glow g2'></div><div class='hero'><div class='hg'><svg viewBox='0 0 1040 484' fill='none'><path d='M150 70 C340 70 330 242 520 242' stroke='var(--rev)' stroke-opacity='.25' stroke-width='2'/><path class='flow' style='--d:0.0s' d='M150 70 C340 70 330 242 520 242' stroke='var(--rev)' stroke-width='2.4'/><path d='M520 242 C710 242 700 70 890 70' stroke='var(--units)' stroke-opacity='.25' stroke-width='2'/><path class='flow' style='--d:0.5s' d='M520 242 C710 242 700 70 890 70' stroke='var(--units)' stroke-width='2.4'/><path d='M150 156 C340 156 330 242 520 242' stroke='var(--rev)' stroke-opacity='.25' stroke-width='2'/><path class='flow' style='--d:0.2s' d='M150 156 C340 156 330 242 520 242' stroke='var(--rev)' stroke-width='2.4'/><path d='M520 242 C710 242 700 156 890 156' stroke='var(--units)' stroke-opacity='.25' stroke-width='2'/><path class='flow' style='--d:0.7s' d='M520 242 C710 242 700 156 890 156' stroke='var(--units)' stroke-width='2.4'/><path d='M150 242 C340 242 330 242 520 242' stroke='var(--rev)' stroke-opacity='.25' stroke-width='2'/><path class='flow' style='--d:0.4s' d='M150 242 C340 242 330 242 520 242' stroke='var(--rev)' stroke-width='2.4'/><path d='M520 242 C710 242 700 242 890 242' stroke='var(--units)' stroke-opacity='.25' stroke-width='2'/><path class='flow' style='--d:0.9s' d='M520 242 C710 242 700 242 890 242' stroke='var(--units)' stroke-width='2.4'/><path d='M150 328 C340 328 330 242 520 242' stroke='var(--rev)' stroke-opacity='.25' stroke-width='2'/><path class='flow' style='--d:0.6s' d='M150 328 C340 328 330 242 520 242' stroke='var(--rev)' stroke-width='2.4'/><path d='M520 242 C710 242 700 328 890 328' stroke='var(--units)' stroke-opacity='.25' stroke-width='2'/><path class='flow' style='--d:1.1s' d='M520 242 C710 242 700 328 890 328' stroke='var(--units)' stroke-width='2.4'/><path d='M150 414 C340 414 330 242 520 242' stroke='var(--rev)' stroke-opacity='.25' stroke-width='2'/><path class='flow' style='--d:0.8s' d='M150 414 C340 414 330 242 520 242' stroke='var(--rev)' stroke-width='2.4'/><path d='M520 242 C710 242 700 414 890 414' stroke='var(--units)' stroke-opacity='.25' stroke-width='2'/><path class='flow' style='--d:1.3s' d='M520 242 C710 242 700 414 890 414' stroke='var(--units)' stroke-width='2.4'/><g><circle cx='150' cy='70' r='24' fill='var(--surface)' stroke='var(--rev)' stroke-width='2'/><path transform='translate(138 58)' d='M3 21V9l6 4V9l6 4V4h6v17z' stroke='var(--rev)' stroke-width='1.8' stroke-linejoin='round' stroke-linecap='round'/></g><g><circle cx='890' cy='70' r='24' fill='var(--surface)' stroke='var(--units)' stroke-width='2'/><path transform='translate(878 58)' d='M12 21s7-6.200 7-11.500A7 7 0 0 0 5 9.500C5 14.800 12 21 12 21z' stroke='var(--units)' stroke-width='1.8' stroke-linejoin='round'/><circle cx='890' cy='68' r='2.600' fill='var(--units)'/></g><g><circle cx='150' cy='156' r='24' fill='var(--surface)' stroke='var(--rev)' stroke-width='2'/><path transform='translate(138 144)' d='M3 21V9l6 4V9l6 4V4h6v17z' stroke='var(--rev)' stroke-width='1.8' stroke-linejoin='round' stroke-linecap='round'/></g><g><circle cx='890' cy='156' r='24' fill='var(--surface)' stroke='var(--units)' stroke-width='2'/><path transform='translate(878 144)' d='M12 21s7-6.200 7-11.500A7 7 0 0 0 5 9.500C5 14.800 12 21 12 21z' stroke='var(--units)' stroke-width='1.8' stroke-linejoin='round'/><circle cx='890' cy='154' r='2.600' fill='var(--units)'/></g><g><circle cx='150' cy='242' r='24' fill='var(--surface)' stroke='var(--rev)' stroke-width='2'/><path transform='translate(138 230)' d='M3 21V9l6 4V9l6 4V4h6v17z' stroke='var(--rev)' stroke-width='1.8' stroke-linejoin='round' stroke-linecap='round'/></g><g><circle cx='890' cy='242' r='24' fill='var(--surface)' stroke='var(--units)' stroke-width='2'/><path transform='translate(878 230)' d='M12 21s7-6.200 7-11.500A7 7 0 0 0 5 9.500C5 14.800 12 21 12 21z' stroke='var(--units)' stroke-width='1.8' stroke-linejoin='round'/><circle cx='890' cy='240' r='2.600' fill='var(--units)'/></g><g><circle cx='150' cy='328' r='24' fill='var(--surface)' stroke='var(--rev)' stroke-width='2'/><path transform='translate(138 316)' d='M3 21V9l6 4V9l6 4V4h6v17z' stroke='var(--rev)' stroke-width='1.8' stroke-linejoin='round' stroke-linecap='round'/></g><g><circle cx='890' cy='328' r='24' fill='var(--surface)' stroke='var(--units)' stroke-width='2'/><path transform='translate(878 316)' d='M12 21s7-6.200 7-11.500A7 7 0 0 0 5 9.500C5 14.800 12 21 12 21z' stroke='var(--units)' stroke-width='1.8' stroke-linejoin='round'/><circle cx='890' cy='326' r='2.600' fill='var(--units)'/></g><g><circle cx='150' cy='414' r='24' fill='var(--surface)' stroke='var(--rev)' stroke-width='2'/><path transform='translate(138 402)' d='M3 21V9l6 4V9l6 4V4h6v17z' stroke='var(--rev)' stroke-width='1.8' stroke-linejoin='round' stroke-linecap='round'/></g><g><circle cx='890' cy='414' r='24' fill='var(--surface)' stroke='var(--units)' stroke-width='2'/><path transform='translate(878 402)' d='M12 21s7-6.200 7-11.500A7 7 0 0 0 5 9.500C5 14.800 12 21 12 21z' stroke='var(--units)' stroke-width='1.8' stroke-linejoin='round'/><circle cx='890' cy='412' r='2.600' fill='var(--units)'/></g><circle class='ring' cx='520' cy='242' r='46' stroke='var(--rev)' stroke-width='2'/><circle class='ring' style='--d:1.1s' cx='520' cy='242' r='46' stroke='var(--rev)' stroke-width='2'/><circle cx='520' cy='242' r='46' fill='var(--surface)' stroke='var(--rev)' stroke-width='3'/><path transform='translate(502 224) scale(1.5)' d='M21 8l-9-5-9 5 9 5z M3 8v8l9 5 9-5V8 M12 13v8' stroke='var(--rev)' stroke-width='1.600' stroke-linejoin='round' stroke-linecap='round'/><circle cx='520' cy='242' r='0'/><circle r='5.5' fill='var(--time)'><animateMotion dur='4.0s' begin='0.00s' repeatCount='indefinite' path='M150 70 C340 70 330 242 520 242'/></circle><circle r='5.5' fill='var(--cost)'><animateMotion dur='4.4s' begin='0.10s' repeatCount='indefinite' path='M520 242 C710 242 700 70 890 70'/></circle><circle r='5.5' fill='var(--time)'><animateMotion dur='4.4s' begin='0.15s' repeatCount='indefinite' path='M150 156 C340 156 330 242 520 242'/></circle><circle r='5.5' fill='var(--cost)'><animateMotion dur='4.7s' begin='0.25s' repeatCount='indefinite' path='M520 242 C710 242 700 156 890 156'/></circle><circle r='5.5' fill='var(--time)'><animateMotion dur='4.8s' begin='0.30s' repeatCount='indefinite' path='M150 242 C340 242 330 242 520 242'/></circle><circle r='5.5' fill='var(--cost)'><animateMotion dur='5.0s' begin='0.40s' repeatCount='indefinite' path='M520 242 C710 242 700 242 890 242'/></circle><circle r='5.5' fill='var(--time)'><animateMotion dur='5.2s' begin='0.45s' repeatCount='indefinite' path='M150 328 C340 328 330 242 520 242'/></circle><circle r='5.5' fill='var(--cost)'><animateMotion dur='5.3s' begin='0.55s' repeatCount='indefinite' path='M520 242 C710 242 700 328 890 328'/></circle><circle r='5.5' fill='var(--time)'><animateMotion dur='5.6s' begin='0.60s' repeatCount='indefinite' path='M150 414 C340 414 330 242 520 242'/></circle><circle r='5.5' fill='var(--cost)'><animateMotion dur='5.6s' begin='0.70s' repeatCount='indefinite' path='M520 242 C710 242 700 414 890 414'/></circle><text x='150' y='470' text-anchor='middle' class='hl'>5 SUPPLIERS</text><text x='520' y='470' text-anchor='middle' class='hl'>DISTRIBUTION</text><text x='890' y='470' text-anchor='middle' class='hl'>5 CITIES</text></svg></div></div><div class='kick'><i></i>Skincare &middot; Haircare &middot; Cosmetics supply network</div><div class='h1'>Supply chain<br><span class='acc'>performance</span></div><div class='lead'>One view of revenue, supplier quality, logistics cost and stock risk across <b>" & FORMAT([# SKUs], "#,##0", "en-US") & " SKUs</b>, <b>" & FORMAT(DISTINCTCOUNT('Supply Chain'[Supplier Key]), "0", "en-US") & " suppliers</b> and <b>" & FORMAT(DISTINCTCOUNT('Supply Chain'[Location Key]), "0", "en-US") & " cities</b>.</div><div class='cta'>Start exploring <svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14M13 6l6 6-6 6'/></svg></div><div class='ik'><div class='it2' style='--ac:var(--rev);--d:0.10s'><div class='ii'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M15 9.5c-.5-1-1.5-1.5-3-1.5-1.7 0-3 .9-3 2.200 0 3 6 1.500 6 4.300 0 1.300-1.300 2.200-3 2.200-1.500 0-2.600-.6-3.100-1.700M12 6v2M12 16v2'/></svg></div><div><div class='iv'>" & IF([Total Revenue] >= 1000000, FORMAT([Total Revenue] / 1000000, "0.00", "en-US") & "M", FORMAT([Total Revenue] / 1000, "#,##0.0", "en-US") & "K") & "<small></small></div><div class='il'>Total revenue</div></div></div><div class='it2' style='--ac:var(--units);--d:0.18s'><div class='ii'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21 8l-9-5-9 5 9 5z'/><path d='M3 8v8l9 5 9-5V8'/><path d='M12 13v8'/></svg></div><div><div class='iv'>" & FORMAT([Total Units Sold], "#,##0", "en-US") & "<small></small></div><div class='il'>Units sold</div></div></div><div class='it2' style='--ac:var(--c1);--d:0.26s'><div class='ii'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 12V4h8l10 10-8 8z'/><circle cx='7.5' cy='8.5' r='1.3'/></svg></div><div><div class='iv'>" & FORMAT([# SKUs], "#,##0", "en-US") & "<small></small></div><div class='il'>SKUs</div></div></div><div class='it2' style='--ac:var(--defect);--d:0.34s'><div class='ii'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3l8 4v5c0 4.500-3.200 8-8 9-4.800-1-8-4.500-8-9V7z'/><path d='M12 8v5M12 16.500v.01'/></svg></div><div><div class='iv'>" & FORMAT([Weighted Defect Rate], "0.00", "en-US") & "<small>%</small></div><div class='il'>Weighted defect rate</div></div></div><div class='it2' style='--ac:var(--time);--d:0.42s'><div class='ii'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 2'/></svg></div><div><div class='iv'>" & FORMAT([Avg Fulfillment Days], "0.0", "en-US") & "<small>days</small></div><div class='il'>Avg fulfillment time</div></div></div></div><div class='ics'><div class='ic' style='--ac:var(--rev);--d:0.2s'><div class='icn'>01</div><div class='ict'><div class='ii'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='7' height='9' rx='1.5'/><rect x='14' y='3' width='7' height='5' rx='1.5'/><rect x='14' y='12' width='7' height='9' rx='1.5'/><rect x='3' y='16' width='7' height='5' rx='1.5'/></svg></div><h3>Revenue &amp; network</h3></div><div class='icd'>Where the money comes from and how the network is spread.</div><ul class='icb'><li>Revenue mix by product type</li><li>Map of cities and lead times</li><li>Auto-written key insights</li></ul><div class='icf'><div><small>Total revenue</small><b>" & IF([Total Revenue] >= 1000000, FORMAT([Total Revenue] / 1000000, "0.00", "en-US") & "M", FORMAT([Total Revenue] / 1000, "#,##0.0", "en-US") & "K") & "</b></div><span>Open &rarr;</span></div></div><div class='ic' style='--ac:var(--defect);--d:0.35s'><div class='icn'>02</div><div class='ict'><div class='ii'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3l8 4v5c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V7z'/><path d='M8.5 12l2.5 2.5L15.5 10'/></svg></div><h3>Supplier &amp; quality</h3></div><div class='icd'>Who delivers quality at the best cost.</div><ul class='icb'><li>Supplier scorecard heat table</li><li>Defects by manufacturing cost band</li><li>Inspections and defect watchlist</li></ul><div class='icf'><div><small>Weighted defect rate</small><b>" & FORMAT([Weighted Defect Rate], "0.00", "en-US") & "%</b></div><span>Open &rarr;</span></div></div><div class='ic' style='--ac:var(--time);--d:0.5s'><div class='icn'>03</div><div class='ict'><div class='ii'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 7h11v9H3z'/><path d='M14 10h4l3 3v3h-7z'/><circle cx='7' cy='18' r='1.8'/><circle cx='17' cy='18' r='1.8'/></svg></div><h3>Logistics &amp; stock</h3></div><div class='icd'>Where speed, cost and stock risk collide.</div><ul class='icb'><li>Transport mode trade-off</li><li>Carrier and route cost heatmap</li><li>Critical SKUs to replenish first</li></ul><div class='icf'><div><small>Critical-stock SKUs</small><b>" & FORMAT([Critical Stock SKUs], "#,##0", "en-US") & "</b></div><span>Open &rarr;</span></div></div></div><div class='foot'>Source: supply_chain_data.csv &middot; " & FORMAT([# SKUs], "#,##0", "en-US") & " SKUs &middot; " & FORMAT(DISTINCTCOUNT('Supply Chain'[Supplier Key]), "0", "en-US") & " suppliers &middot; " & FORMAT(DISTINCTCOUNT('Supply Chain'[Location Key]), "0", "en-US") & " cities &middot; " & FORMAT(DISTINCTCOUNT('Supply Chain'[Transport Mode Key]), "0", "en-US") & " transport modes</div></div>"
		displayFolder: Visuals
		lineageTag: bca76269-64e8-4d3d-90c8-c479daf1fa49

	/// HTML for the Info revenue_mix visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info revenue_mix' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Revenue mix by product type</b></div><p><em>What it shows</em>How the revenue in view splits between Cosmetics, Haircare and Skincare.</p><p><em>How to read it</em>A bigger slice means more revenue. The centre shows the total. The list on the right gives each amount and share.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: cdc42890-c59e-4272-ba01-3914e43d2251

	/// HTML for the Info location_map visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info location_map' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Where the revenue sits</b></div><p><em>What it shows</em>Revenue for each city, drawn on a map.</p><p><em>How to read it</em>A bigger bubble means more revenue. Hover a bubble to see the exact figure.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: bb911706-66e5-465a-bad6-ff1ec783c013

	/// HTML for the Info key_insights visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info key_insights' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Key insights</b></div><p><em>What it shows</em>Short sentences written from the data in view: best and worst supplier on defects, the slowest city, stock risk and the A-class SKUs.</p><p><em>How to read it</em>They update every time you change a filter, so they always describe what you are looking at.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: 50155bfa-b323-4863-97dc-5590569d9923

	/// HTML for the Info supplier_revenue visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info supplier_revenue' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Revenue by supplier</b></div><p><em>What it shows</em>Total revenue of each supplier, split by product type.</p><p><em>How to read it</em>The longer the bar, the more revenue. The number inside a colour is that product type's revenue. The total is on the right.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: 54f98c50-6dd0-41f9-91b3-bafe79448b84

	/// HTML for the Info segment_revenue visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info segment_revenue' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Revenue by customer segment</b></div><p><em>What it shows</em>Which customer groups buy the most.</p><p><em>How to read it</em>The number inside each bar is its revenue and its share of all revenue in view.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: 82116f72-5474-435a-875d-c9c4ce652d7d

	/// HTML for the Info supplier_scorecard visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info supplier_scorecard' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Supplier scorecard</b></div><p><em>What it shows</em>One row per supplier with revenue, defects, failed inspections, cost and lead times.</p><p><em>How to read it</em>A darker cell means a higher value. BEST marks the supplier with the preferred value in that column: highest revenue, lowest for everything else.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: eed26472-97f4-4a0a-94b3-bbaef960e8d1

	/// HTML for the Info quality_cost_bands visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info quality_cost_bands' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Does a higher cost buy fewer defects?</b></div><p><em>What it shows</em>SKUs are grouped by manufacturing cost per unit (low under 34, mid 34 to 67, high 68 and up). Each bar is the group's average defect rate.</p><p><em>How to read it</em>If the three bars are similar, a higher cost does not buy better quality. The box underneath says it in one sentence.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: 9aaa3370-7108-4a32-96a8-2e15fb09e230

	/// HTML for the Info inspection_outcomes visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info inspection_outcomes' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Inspection outcomes</b></div><p><em>What it shows</em>How many SKUs of each supplier passed, are pending or failed inspection.</p><p><em>How to read it</em>Each bar shows the counts. The percentage on the right is the share that failed, so a lower number is better.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: f755668b-6170-4df6-ac97-40c16e016a1c

	/// HTML for the Info leadtime_buildup visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info leadtime_buildup' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Where the time goes</b></div><p><em>What it shows</em>Average days from order to delivery, built from supplier lead time, manufacturing lead time and shipping time.</p><p><em>How to read it</em>The three colours stack into the total on the right. A long colour shows which step to speed up.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: 6d37fa8e-1f27-498e-8e04-73a648495dbb

	/// HTML for the Info defect_watchlist visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info defect_watchlist' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Defect watchlist</b></div><p><em>What it shows</em>The five SKUs with the highest defect rate in view.</p><p><em>How to read it</em>The bar fills up to 5 percent. Use the inspection result to see which ones already failed.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: 9bf68f9f-0dcc-4ebd-a296-df6037394394

	/// HTML for the Info mode_tradeoff visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info mode_tradeoff' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Transport modes: speed vs cost</b></div><p><em>What it shows</em>Each bubble is a transport mode.</p><p><em>How to read it</em>Further right is slower, higher is more expensive, a bigger bubble carries more SKUs. The bottom left corner is fast and cheap.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: 2558d8e4-14e1-4e5b-b06d-106228d79226

	/// HTML for the Info carrier_route_heatmap visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info carrier_route_heatmap' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Carrier and route cost</b></div><p><em>What it shows</em>The average cost of each carrier on each route.</p><p><em>How to read it</em>A darker cell means a higher cost. The small line shows how many SKUs and how many shipping days sit behind it.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: 3216e59a-9877-45d1-9c7c-e8a38f2fe3e2

	/// HTML for the Info stock_vs_order visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info stock_vs_order' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Who is short on stock?</b></div><p><em>What it shows</em>Each marker is a SKU, plotted by order quantity and stock level.</p><p><em>How to read it</em>Markers below the dashed line hold less stock than the quantity usually ordered. The shape tells the stock status.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: 8ad20a24-cbd5-4016-9ccd-1c389136e951

	/// HTML for the Info stock_status_location visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info stock_status_location' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Stock health by location</b></div><p><em>What it shows</em>For each city, how many SKUs are critical, below their order quantity, or healthy.</p><p><em>How to read it</em>Critical means 10 units or fewer. Cities with the biggest red share are listed first.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: 755388f6-b95d-42e6-8586-afbd83dcd9ce

	/// HTML for the Info critical_queue visual. Bind it to the HTML Content custom visual.
	measure 'HTML Info critical_queue' = [HTML Head] & "<div class='ip'><div class='ipt'><span class='inf'>i</span><b>Replenish first</b></div><p><em>What it shows</em>The SKUs that hold less stock than their order quantity, most urgent first.</p><p><em>How to read it</em>Sorted by lowest stock, then by the longest supplier lead time. The bar shows stock as a share of the order quantity.</p><div class='iph'>Press the i icon or this panel to close.</div></div>"
		displayFolder: Visuals
		lineageTag: 6af3a004-b801-45b0-97e9-af2f15bf7735

	/// HTML for the Narrative Guide visual. Bind it to the HTML Content custom visual.
	measure 'HTML Narrative Guide' = [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>How to use the AI narrative</div><div class='sub'>the text above is written by Power BI from the charts on this page</div></div><div class='gdg'><div class='gs'><div class='gn'>1</div><b>Filter</b><p>Press Filters in the left menu and pick a supplier, city, product type or transport mode. The text rewrites itself for your selection.</p></div><div class='gs'><div class='gn'>2</div><b>Click a bar</b><p>Select a bar or column in either chart. The narrative switches to that supplier. Click it again to go back to all suppliers.</p></div><div class='gs'><div class='gn'>3</div><b>Read the numbers</b><p>Every figure in the text is live. It also names the highest and lowest values and says how big the gap is.</p></div><div class='gs'><div class='gn'>4</div><b>Make it yours</b><p>In Power BI Desktop select the narrative, choose Edit text, and add your own words or a live value with + Value. In the service, use Summarize.</p></div></div></div>"
		displayFolder: Visuals
		lineageTag: 27c31d86-5cf9-477f-ad5e-4be31e24e641

	/// HTML for the Supplier Scorecard visual. Bind it to the HTML Content custom visual.
	measure 'HTML Supplier Scorecard' =
			VAR _n = [# SKUs]
			VAR _t = ADDCOLUMNS(VALUES('Supplier'[Supplier]), "x1", [Total Revenue], "x2", [Weighted Defect Rate], "x3", [Failed Inspection Rate], "x4", [Avg Manufacturing Cost], "x5", [Avg Supplier Lead Time], "x6", [Avg Manufacturing Lead Time])
			VAR _cnt = COUNTROWS(_t)
			VAR _mn1 = MINX(_t, [x1])
			VAR _mx1 = MAXX(_t, [x1])
			VAR _mn2 = MINX(_t, [x2])
			VAR _mx2 = MAXX(_t, [x2])
			VAR _mn3 = MINX(_t, [x3])
			VAR _mx3 = MAXX(_t, [x3])
			VAR _mn4 = MINX(_t, [x4])
			VAR _mx4 = MAXX(_t, [x4])
			VAR _mn5 = MINX(_t, [x5])
			VAR _mx5 = MAXX(_t, [x5])
			VAR _mn6 = MINX(_t, [x6])
			VAR _mx6 = MAXX(_t, [x6])
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Supplier scorecard" & "</div><div class='sub'>" & "darker = higher value · BEST = preferred direction" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='col'><table class='sg'><tr><th>Supplier</th>" & "<th>Revenue</th><th>Defect rate</th><th>Failed inspections</th><th>Mfg cost / unit</th><th>Supplier lead time</th><th>Mfg lead time</th>" & "</tr>" & CONCATENATEX(_t, "<tr><td>" & 'Supplier'[Supplier] & "</td>" & "<td class='h' style='--hc:var(--" & "rev" & ");--i:" & FORMAT(0.08 + 0.34 * DIVIDE([x1] - _mn1, _mx1 - _mn1, 0.5), "0.00", "en-US") & ";--d:" & FORMAT(RANKX(_t, [x1], , DESC) * 0.08 + 0.04, "0.00", "en-US") & "s'><span>" & IF([x1] >= 1000000, FORMAT([x1] / 1000000, "0.00", "en-US") & "M", FORMAT([x1] / 1000, "#,##0.0", "en-US") & "K") & "</span>" & IF(_cnt > 1 && [x1] = _mx1, "<span class='tag'>BEST</span>", "") & "</td>" & "<td class='h' style='--hc:var(--" & "defect" & ");--i:" & FORMAT(0.08 + 0.34 * DIVIDE([x2] - _mn2, _mx2 - _mn2, 0.5), "0.00", "en-US") & ";--d:" & FORMAT(RANKX(_t, [x1], , DESC) * 0.08 + 0.08, "0.00", "en-US") & "s'><span>" & FORMAT([x2], "0.00", "en-US") & "%" & "</span>" & IF(_cnt > 1 && [x2] = _mn2, "<span class='tag'>BEST</span>", "") & "</td>" & "<td class='h' style='--hc:var(--" & "risk" & ");--i:" & FORMAT(0.08 + 0.34 * DIVIDE([x3] - _mn3, _mx3 - _mn3, 0.5), "0.00", "en-US") & ";--d:" & FORMAT(RANKX(_t, [x1], , DESC) * 0.08 + 0.12, "0.00", "en-US") & "s'><span>" & FORMAT([x3], "0%", "en-US") & "</span>" & IF(_cnt > 1 && [x3] = _mn3, "<span class='tag'>BEST</span>", "") & "</td>" & "<td class='h' style='--hc:var(--" & "cost" & ");--i:" & FORMAT(0.08 + 0.34 * DIVIDE([x4] - _mn4, _mx4 - _mn4, 0.5), "0.00", "en-US") & ";--d:" & FORMAT(RANKX(_t, [x1], , DESC) * 0.08 + 0.16, "0.00", "en-US") & "s'><span>" & FORMAT([x4], "0.0", "en-US") & "</span>" & IF(_cnt > 1 && [x4] = _mn4, "<span class='tag'>BEST</span>", "") & "</td>" & "<td class='h' style='--hc:var(--" & "time" & ");--i:" & FORMAT(0.08 + 0.34 * DIVIDE([x5] - _mn5, _mx5 - _mn5, 0.5), "0.00", "en-US") & ";--d:" & FORMAT(RANKX(_t, [x1], , DESC) * 0.08 + 0.2, "0.00", "en-US") & "s'><span>" & FORMAT([x5], "0.0", "en-US") & " d" & "</span>" & IF(_cnt > 1 && [x5] = _mn5, "<span class='tag'>BEST</span>", "") & "</td>" & "<td class='h' style='--hc:var(--" & "time" & ");--i:" & FORMAT(0.08 + 0.34 * DIVIDE([x6] - _mn6, _mx6 - _mn6, 0.5), "0.00", "en-US") & ";--d:" & FORMAT(RANKX(_t, [x1], , DESC) * 0.08 + 0.24, "0.00", "en-US") & "s'><span>" & FORMAT([x6], "0.0", "en-US") & " d" & "</span>" & IF(_cnt > 1 && [x6] = _mn6, "<span class='tag'>BEST</span>", "") & "</td>" & "</tr>", "", [x1], DESC) & "</table></div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: 0f5398dd-cb37-46f9-96ea-42dca7e9ae02

	/// HTML for the Cost Quality Bands visual. Bind it to the HTML Content custom visual.
	measure 'HTML Cost Quality Bands' =
			VAR _n = [# SKUs]
			VAR _b = ADDCOLUMNS(GENERATESERIES(1, 3), "x_n", COUNTROWS(FILTER('Supply Chain', IF('Supply Chain'[Manufacturing Cost per Unit] < 34, 1, IF('Supply Chain'[Manufacturing Cost per Unit] < 68, 2, 3)) = [Value])), "x_d", AVERAGEX(FILTER('Supply Chain', IF('Supply Chain'[Manufacturing Cost per Unit] < 34, 1, IF('Supply Chain'[Manufacturing Cost per Unit] < 68, 2, 3)) = [Value]), 'Supply Chain'[Defect Rate]))
			VAR _max = MAXX(_b, [x_d])
			VAR _lo = MAXX(FILTER(_b, [Value] = 1), [x_d])
			VAR _hi = MAXX(FILTER(_b, [Value] = 3), [x_d])
			VAR _ok = MAXX(FILTER(_b, [Value] = 1), [x_n]) > 0 && MAXX(FILTER(_b, [Value] = 3), [x_n]) > 0
			VAR _gap = _hi - _lo
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Does a higher cost buy fewer defects?" & "</div><div class='sub'>" & "average defect rate by manufacturing cost per unit" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='list'>" & CONCATENATEX(_b, "<div class='hb big' style='grid-template-columns:150px 1fr 72px'><div class='nm'>" & SWITCH([Value], 1, "Low cost", 2, "Mid cost", "High cost") & "<small class='bs'>" & SWITCH([Value], 1, "under 34 per unit", 2, "34 to 67 per unit", "68 and up per unit") & "</small></div><div class='tr'><div class='st' style='width:" & FORMAT(DIVIDE([x_d], _max, 0) * 100, "0.0", "en-US") & "%;--d:" & FORMAT([Value] * 0.1, "0.00", "en-US") & "s'><i class='dfb' style='flex:1' title='" & SWITCH([Value], 1, "Low cost", 2, "Mid cost", "High cost") & " · average defect rate " & IF([x_n] = 0, "-", FORMAT([x_d], "0.00", "en-US") & "%") & " · " & FORMAT([x_n], "0", "en-US") & " SKUs'><em>" & IF([x_n] = 0, "-", FORMAT([x_d], "0.00", "en-US") & "%") & "</em></i></div></div><div class='vl'>" & FORMAT([x_n], "0", "en-US") & " SKUs</div></div>", "", [Value], ASC) & "<div class='vd'><b>" & IF(NOT(_ok), "Not enough low- and high-cost SKUs in view to compare", IF(ABS(_gap) < 0.25, "Cost does not predict quality", IF(_gap < 0, "Higher cost goes with fewer defects", "Higher cost goes with more defects"))) & "</b><span>" & IF(_ok, "High-cost SKUs average " & FORMAT(_hi, "0.00", "en-US") & "% defects, low-cost SKUs " & FORMAT(_lo, "0.00", "en-US") & "%.", "Clear a filter to see all three groups.") & "</span></div></div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: ceec8648-5998-4161-a083-71893676cd49

	/// HTML for the Inspection By Supplier visual. Bind it to the HTML Content custom visual.
	measure 'HTML Inspection By Supplier' =
			VAR _n = [# SKUs]
			VAR _s = ADDCOLUMNS(VALUES('Supplier'[Supplier]), "x_p", CALCULATE(COUNTROWS('Supply Chain'), 'Inspection'[Inspection Result] = "Pass"), "x_e", CALCULATE(COUNTROWS('Supply Chain'), 'Inspection'[Inspection Result] = "Pending"), "x_f", CALCULATE(COUNTROWS('Supply Chain'), 'Inspection'[Inspection Result] = "Fail"))
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Inspection outcomes" & "</div><div class='sub'>" & "SKUs by supplier · right column = fail rate" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='list'><div class='keys' style='margin-bottom:2px'><span><i class='sw' style='background:var(--good)'></i>✓ Pass</span><span><i class='sw' style='background:var(--warn)'></i>… Pending</span><span><i class='sw' style='background:var(--risk)'></i>✕ Fail</span></div>" & CONCATENATEX(_s, "<div class='hb cmp' style='grid-template-columns:84px 1fr 56px'><div class='nm'>" & 'Supplier'[Supplier] & "</div><div class='tr' style='height:22px'><div class='st' style='width:100%;--d:" & FORMAT(RANKX(_s, [x_f], , DESC) * 0.08, "0.00", "en-US") & "s'><i class='g' style='flex:" & FORMAT([x_p], "0", "en-US") & "' title='" & 'Supplier'[Supplier] & " · Pass · " & FORMAT([x_p], "0", "en-US") & " SKUs'><em>" & IF(DIVIDE([x_p], [x_p] + [x_e] + [x_f], 0) >= 0.08, "✓ " & FORMAT([x_p], "0", "en-US"), "") & "</em></i><i class='w' style='flex:" & FORMAT([x_e], "0", "en-US") & "' title='" & 'Supplier'[Supplier] & " · Pending · " & FORMAT([x_e], "0", "en-US") & " SKUs'><em>" & IF(DIVIDE([x_e], [x_p] + [x_e] + [x_f], 0) >= 0.08, "… " & FORMAT([x_e], "0", "en-US"), "") & "</em></i><i class='r' style='flex:" & FORMAT([x_f], "0", "en-US") & "' title='" & 'Supplier'[Supplier] & " · Fail · " & FORMAT([x_f], "0", "en-US") & " SKUs'><em>" & IF(DIVIDE([x_f], [x_p] + [x_e] + [x_f], 0) >= 0.08, "✕ " & FORMAT([x_f], "0", "en-US"), "") & "</em></i></div></div><div class='vl'>" & FORMAT(DIVIDE([x_f], [x_p] + [x_e] + [x_f], 0), "0%", "en-US") & "</div></div>", "", DIVIDE([x_f], [x_p] + [x_e] + [x_f], 0), DESC) & "</div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: 27d052fe-36c2-4add-86ec-58843e3b17df

	/// HTML for the Lead Time Buildup visual. Bind it to the HTML Content custom visual.
	measure 'HTML Lead Time Buildup' =
			VAR _n = [# SKUs]
			VAR _s = ADDCOLUMNS(VALUES('Supplier'[Supplier]), "x_a", [Avg Supplier Lead Time], "x_b", [Avg Manufacturing Lead Time], "x_c", [Avg Shipping Time])
			VAR _s2 = ADDCOLUMNS(_s, "x_t", [x_a] + [x_b] + [x_c])
			VAR _max = MAXX(_s2, [x_t])
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Where the time goes" & "</div><div class='sub'>" & "average fulfillment days per SKU, by supplier" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='list'><div class='keys' style='margin-bottom:2px'><span><i class='sw' style='background:var(--warn)'></i>Supplier lead time</span><span><i class='sw' style='background:var(--c4)'></i>Manufacturing lead time</span><span><i class='sw' style='background:var(--rev)'></i>Shipping time</span></div>" & CONCATENATEX(_s2, "<div class='hb cmp' style='grid-template-columns:84px 1fr 70px'><div class='nm'>" & 'Supplier'[Supplier] & "</div><div class='tr' style='height:22px'><div class='st' style='width:" & FORMAT(DIVIDE([x_t], _max, 0) * 100, "0.0", "en-US") & "%;--d:" & FORMAT(RANKX(_s2, [x_t], , DESC) * 0.08, "0.00", "en-US") & "s'><i class='s1' style='flex:" & FORMAT([x_a], "0.00", "en-US") & "' title='" & 'Supplier'[Supplier] & " · supplier lead time · " & FORMAT([x_a], "0.0", "en-US") & " days'><em>" & FORMAT([x_a], "0.0", "en-US") & "</em></i><i class='s2' style='flex:" & FORMAT([x_b], "0.00", "en-US") & "' title='" & 'Supplier'[Supplier] & " · manufacturing lead time · " & FORMAT([x_b], "0.0", "en-US") & " days'><em>" & FORMAT([x_b], "0.0", "en-US") & "</em></i><i class='s3' style='flex:" & FORMAT([x_c], "0.00", "en-US") & "' title='" & 'Supplier'[Supplier] & " · shipping time · " & FORMAT([x_c], "0.0", "en-US") & " days'><em>" & FORMAT([x_c], "0.0", "en-US") & "</em></i></div></div><div class='vl'>" & FORMAT([x_t], "0.0", "en-US") & " d</div></div>", "", [x_t], DESC) & "</div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: f5033782-660c-495b-b183-d1fefd013571

	/// HTML for the Defect Watchlist visual. Bind it to the HTML Content custom visual.
	measure 'HTML Defect Watchlist' =
			VAR _n = [# SKUs]
			VAR _top = TOPN(5, 'Supply Chain', 'Supply Chain'[Defect Rate], DESC)
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Defect watchlist: five worst SKUs" & "</div><div class='sub'>" & "ranked by defect rate for the current filter" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='col'><table class='tb tight'><tr><th>#</th><th>SKU</th><th>Product type</th><th>Supplier</th><th>Location</th><th>Defect rate</th><th>Inspection</th><th>Revenue</th></tr>" & CONCATENATEX(_top, "<tr style='--d:" & FORMAT(RANKX(_top, 'Supply Chain'[Defect Rate], , DESC) * 0.08, "0.00", "en-US") & "s'><td>" & FORMAT(RANKX(_top, 'Supply Chain'[Defect Rate], , DESC), "0", "en-US") & "</td><td>" & RELATED('Product'[SKU]) & "</td><td>" & RELATED('Product'[Product Type]) & "</td><td>" & RELATED('Supplier'[Supplier]) & "</td><td>" & RELATED('Location'[City]) & "</td><td><div class='bt'><i style='width:" & FORMAT(MIN(100, 'Supply Chain'[Defect Rate] / 5 * 100), "0", "en-US") & "%;--d:" & FORMAT(RANKX(_top, 'Supply Chain'[Defect Rate], , DESC) * 0.08, "0.00", "en-US") & "s' title='" & RELATED('Product'[SKU]) & " · defect rate " & FORMAT('Supply Chain'[Defect Rate], "0.00", "en-US") & "%'>" & FORMAT('Supply Chain'[Defect Rate], "0.00", "en-US") & "%</i></div></td><td><span class='pill " & SWITCH(RELATED('Inspection'[Inspection Result]), "Pass", "p-pass", "Fail", "p-fail", "p-pend") & "'>" & SWITCH(RELATED('Inspection'[Inspection Result]), "Pass", "✓", "Fail", "✕", "…") & " " & RELATED('Inspection'[Inspection Result]) & "</span></td><td>" & IF('Supply Chain'[Revenue] >= 1000000, FORMAT('Supply Chain'[Revenue] / 1000000, "0.00", "en-US") & "M", FORMAT('Supply Chain'[Revenue] / 1000, "#,##0.0", "en-US") & "K") & "</td></tr>", "", 'Supply Chain'[Defect Rate], DESC) & "</table></div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: 69b05b5c-5909-48f1-ad89-85e19daca09b

	/// HTML for the Mode Tradeoff visual. Bind it to the HTML Content custom visual.
	measure 'HTML Mode Tradeoff' =
			VAR _n = [# SKUs]
			VAR _t = ADDCOLUMNS(VALUES('Transport Mode'[Transport Mode]), "x_t", [Avg Shipping Time], "x_c", [Avg Transport Cost], "x_n", [# SKUs], "x_k", CALCULATE(MAX('Transport Mode'[Transport Mode Key])))
			VAR _xp = MAX(0.8, 0.25 * (MAXX(_t, [x_t]) - MINX(_t, [x_t])))
			VAR _yp = MAX(20, 0.25 * (MAXX(_t, [x_c]) - MINX(_t, [x_c])))
			VAR _x0 = MINX(_t, [x_t]) - _xp
			VAR _x1 = MAXX(_t, [x_t]) + _xp
			VAR _y0 = MINX(_t, [x_c]) - _yp
			VAR _y1 = MAXX(_t, [x_c]) + _yp
			VAR _maxN = MAXX(_t, [x_n])
			VAR _cheap = MAXX(TOPN(1, _t, [x_c], ASC), 'Transport Mode'[Transport Mode])
			VAR _fast = MAXX(TOPN(1, _t, [x_t], ASC), 'Transport Mode'[Transport Mode])
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Transport modes: speed vs cost" & "</div><div class='sub'>" & _cheap & " is cheapest · " & _fast & " is fastest" & "</div><div class='inf'>i</div></div><div class='body'>" & ("<svg class='plot' viewBox='0 0 420 250' preserveAspectRatio='xMidYMid meet' style='flex:none;width:350px;height:100%'>" & "<line class='gl' x1='52' y1='212' x2='412' y2='212'></line><line class='gl' x1='52' y1='16' x2='52' y2='212'></line><text class='ax' x='52' y='228' text-anchor='middle'>" & FORMAT(_x0, "0.0", "en-US") & "</text><text class='ax' x='392' y='228' text-anchor='middle'>" & FORMAT(_x1, "0.0", "en-US") & "</text><text class='ax' x='46' y='212' text-anchor='end'>" & FORMAT(_y0, "#,##0", "en-US") & "</text><text class='ax' x='46' y='24' text-anchor='end'>" & FORMAT(_y1, "#,##0", "en-US") & "</text>" & CONCATENATEX(_t, "<g><circle class='dot' cx='" & FORMAT((52 + DIVIDE([x_t] - _x0, _x1 - _x0, 0.5) * 340), "0.0", "en-US") & "' cy='" & FORMAT((212 - DIVIDE([x_c] - _y0, _y1 - _y0, 0.5) * 196), "0.0", "en-US") & "' r='" & FORMAT(9 + 9 * SQRT(DIVIDE([x_n], _maxN, 0)), "0.0", "en-US") & "' fill='var(--c" & [x_k] & ")' fill-opacity='.8' stroke='var(--surface)' stroke-width='2' style='--d:" & FORMAT([x_k] * 0.12, "0.00", "en-US") & "s'></circle><text class='mt' x='" & FORMAT((52 + DIVIDE([x_t] - _x0, _x1 - _x0, 0.5) * 340), "0.0", "en-US") & "' y='" & FORMAT((212 - DIVIDE([x_c] - _y0, _y1 - _y0, 0.5) * 196) + 4, "0.0", "en-US") & "' text-anchor='middle'>" & 'Transport Mode'[Transport Mode] & "</text></g>", "") & "<text class='al' x='412' y='246' text-anchor='end'>shipping days →</text><text class='al' x='52' y='8'>↑ transport cost</text></svg>" & "<table class='tb roomy' style='flex:1;align-self:center'><tr><th>Mode</th><th>Days</th><th>Cost</th><th>SKUs</th></tr>" & CONCATENATEX(_t, "<tr style='--d:" & FORMAT([x_k] * 0.1, "0.00", "en-US") & "s'><td><i class='sw' style='background:var(--c" & [x_k] & ");margin-right:8px'></i>" & 'Transport Mode'[Transport Mode] & "</td><td>" & FORMAT([x_t], "0.0", "en-US") & " d</td><td>" & FORMAT([x_c], "#,##0", "en-US") & "</td><td>" & FORMAT([x_n], "0", "en-US") & "</td></tr>", "", [x_c], ASC) & "</table>") & "</div></div>")
		displayFolder: Visuals
		lineageTag: dfa251bf-b606-49e5-8850-97abf9850870

	/// HTML for the Carrier Route Heatmap visual. Bind it to the HTML Content custom visual.
	measure 'HTML Carrier Route Heatmap' =
			VAR _n = [# SKUs]
			VAR _t = ADDCOLUMNS(CROSSJOIN(VALUES('Carrier'[Carrier]), VALUES('Route'[Route])), "x_c", [Avg Logistics Cost], "x_n", [# SKUs], "x_d", [Avg Shipping Time], "x_r", CALCULATE(MAX('Carrier'[Carrier Key])) + 1, "x_k", CALCULATE(MAX('Route'[Route Key])) + 1)
			VAR _v = FILTER(_t, [x_n] > 0)
			VAR _mn = MINX(_v, [x_c])
			VAR _mx = MAXX(_v, [x_c])
			VAR _cnt = COUNTROWS(_v)
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Logistics cost by carrier and route" & "</div><div class='sub'>" & "average shipping + transport cost per SKU · darker = costlier" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='hm' style='grid-template-columns:110px repeat(3,1fr);grid-template-rows:28px repeat(3,1fr)'>" & CONCATENATEX(VALUES('Route'[Route]), "<div class='hh' style='grid-row:1;grid-column:" & FORMAT(CALCULATE(MAX('Route'[Route Key])) + 1, "0", "en-US") & "'>" & 'Route'[Route] & "</div>", "") & CONCATENATEX(VALUES('Carrier'[Carrier]), "<div class='hh' style='grid-row:" & FORMAT(CALCULATE(MAX('Carrier'[Carrier Key])) + 1, "0", "en-US") & ";grid-column:1;justify-content:flex-start'>" & 'Carrier'[Carrier] & "</div>", "") & CONCATENATEX(_t, IF([x_n] > 0, "<div class='hc' style='grid-row:" & FORMAT([x_r], "0", "en-US") & ";grid-column:" & FORMAT([x_k], "0", "en-US") & ";--hc:var(--cost);--i:" & FORMAT(0.08 + 0.34 * DIVIDE([x_c] - _mn, _mx - _mn, 0.5), "0.00", "en-US") & ";--d:" & FORMAT(([x_r] + [x_k]) * 0.07, "0.00", "en-US") & "s'><b>" & FORMAT([x_c], "#,##0", "en-US") & "</b><small>" & FORMAT([x_n], "0", "en-US") & " SKUs · " & FORMAT([x_d], "0.0", "en-US") & " d shipping</small>" & IF(_cnt > 1 && [x_c] = _mn, "<span class='tag' style='align-self:flex-start;margin:4px 0 0'>LOWEST COST</span>", IF(_cnt > 1 && [x_c] = _mx, "<span class='tag' style='align-self:flex-start;margin:4px 0 0'>HIGHEST COST</span>", "")) & "</div>", "<div class='hc' style='grid-row:" & FORMAT([x_r], "0", "en-US") & ";grid-column:" & FORMAT([x_k], "0", "en-US") & ";--hc:var(--cost);--i:0;'><small>no SKUs</small></div>"), "") & "</div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: 3f0a2bfc-9394-409c-8ba0-c5f1b5dc2d55

	/// HTML for the Stock Vs Order Scatter visual. Bind it to the HTML Content custom visual.
	measure 'HTML Stock Vs Order Scatter' =
			VAR _n = [# SKUs]
			
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Who is short on stock?" & "</div><div class='sub'>" & "below the dashed line = stock < order qty" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='col'><div class='keys'><span><svg width='12' height='12'><circle cx='6' cy='6' r='4.5' fill='var(--good)'/></svg>Healthy</span><span><svg width='12' height='12'><polygon points='6,0.5 11.5,6 6,11.5 0.5,6' fill='var(--warn)'/></svg>Below order qty</span><span><svg width='12' height='12'><polygon points='6,1 11.5,11 0.5,11' fill='var(--risk)'/></svg>Critical (stock ≤ 10)</span></div><svg class='plot' viewBox='0 0 567 300' preserveAspectRatio='xMidYMid meet'>" & "<rect x='44' y='244.0' width='511' height='26.0' fill='var(--risk)' fill-opacity='.10'></rect><line class='gl' x1='44' y1='270.0' x2='555' y2='270.0'></line><text class='ax' x='38' y='274.0' text-anchor='end'>0</text><text class='ax' x='44.0' y='286' text-anchor='middle'>0</text><line class='gl' x1='44' y1='218.0' x2='555' y2='218.0'></line><text class='ax' x='38' y='222.0' text-anchor='end'>20</text><text class='ax' x='146.2' y='286' text-anchor='middle'>20</text><line class='gl' x1='44' y1='166.0' x2='555' y2='166.0'></line><text class='ax' x='38' y='170.0' text-anchor='end'>40</text><text class='ax' x='248.4' y='286' text-anchor='middle'>40</text><line class='gl' x1='44' y1='114.0' x2='555' y2='114.0'></line><text class='ax' x='38' y='118.0' text-anchor='end'>60</text><text class='ax' x='350.6' y='286' text-anchor='middle'>60</text><line class='gl' x1='44' y1='62.0' x2='555' y2='62.0'></line><text class='ax' x='38' y='66.0' text-anchor='end'>80</text><text class='ax' x='452.8' y='286' text-anchor='middle'>80</text><line class='gl' x1='44' y1='10.0' x2='555' y2='10.0'></line><text class='ax' x='38' y='14.0' text-anchor='end'>100</text><text class='ax' x='555.0' y='286' text-anchor='middle'>100</text><line x1='44' y1='270' x2='555' y2='10' stroke='var(--muted)' stroke-dasharray='5 5' stroke-width='1.3'></line><text class='ax' x='500' y='34' text-anchor='end' transform='rotate(-27 500 34)'>stock = order qty</text><text class='al' x='555' y='298' text-anchor='end'>order quantity →</text><text class='al' x='44' y='8'>↑ stock level</text><text class='ax' x='50' y='262'>critical zone</text>" & CONCATENATEX('Supply Chain', SWITCH('Supply Chain'[Stock Status], "Critical", "<polygon class='dot crit' points='" & FORMAT((44 + 'Supply Chain'[Order Quantity] / 100 * 511), "0.0", "en-US") & "," & FORMAT((270 - 'Supply Chain'[Stock Level] / 100 * 260) - 6, "0.0", "en-US") & " " & FORMAT((44 + 'Supply Chain'[Order Quantity] / 100 * 511) + 6, "0.0", "en-US") & "," & FORMAT((270 - 'Supply Chain'[Stock Level] / 100 * 260) + 5, "0.0", "en-US") & " " & FORMAT((44 + 'Supply Chain'[Order Quantity] / 100 * 511) - 6, "0.0", "en-US") & "," & FORMAT((270 - 'Supply Chain'[Stock Level] / 100 * 260) + 5, "0.0", "en-US") & "' fill='var(--risk)' style='--d:" & FORMAT('Supply Chain'[Order Quantity] / 100 * 0.8, "0.00", "en-US") & "s'><title>" & RELATED('Product'[SKU]) & " · " & RELATED('Location'[City]) & " · stock " & 'Supply Chain'[Stock Level] & " / order " & 'Supply Chain'[Order Quantity] & "</title></polygon>", "Reorder", "<polygon class='dot' points='" & FORMAT((44 + 'Supply Chain'[Order Quantity] / 100 * 511), "0.0", "en-US") & "," & FORMAT((270 - 'Supply Chain'[Stock Level] / 100 * 260) - 6, "0.0", "en-US") & " " & FORMAT((44 + 'Supply Chain'[Order Quantity] / 100 * 511) + 6, "0.0", "en-US") & "," & FORMAT((270 - 'Supply Chain'[Stock Level] / 100 * 260), "0.0", "en-US") & " " & FORMAT((44 + 'Supply Chain'[Order Quantity] / 100 * 511), "0.0", "en-US") & "," & FORMAT((270 - 'Supply Chain'[Stock Level] / 100 * 260) + 5, "0.0", "en-US") & " " & FORMAT((44 + 'Supply Chain'[Order Quantity] / 100 * 511) - 6, "0.0", "en-US") & "," & FORMAT((270 - 'Supply Chain'[Stock Level] / 100 * 260), "0.0", "en-US") & "' fill='var(--warn)' fill-opacity='.9' style='--d:" & FORMAT('Supply Chain'[Order Quantity] / 100 * 0.8, "0.00", "en-US") & "s'><title>" & RELATED('Product'[SKU]) & " · " & RELATED('Location'[City]) & " · stock " & 'Supply Chain'[Stock Level] & " / order " & 'Supply Chain'[Order Quantity] & "</title></polygon>", "<circle class='dot' cx='" & FORMAT((44 + 'Supply Chain'[Order Quantity] / 100 * 511), "0.0", "en-US") & "' cy='" & FORMAT((270 - 'Supply Chain'[Stock Level] / 100 * 260), "0.0", "en-US") & "' r='4.2' fill='var(--good)' fill-opacity='.8' style='--d:" & FORMAT('Supply Chain'[Order Quantity] / 100 * 0.8, "0.00", "en-US") & "s'><title>" & RELATED('Product'[SKU]) & " · " & RELATED('Location'[City]) & " · stock " & 'Supply Chain'[Stock Level] & " / order " & 'Supply Chain'[Order Quantity] & "</title></circle>"), "") & "</svg></div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: 69e2d727-81a5-43ff-a388-0421b8879b47

	/// HTML for the Stock Status By Location visual. Bind it to the HTML Content custom visual.
	measure 'HTML Stock Status By Location' =
			VAR _n = [# SKUs]
			VAR _s = ADDCOLUMNS(VALUES('Location'[City]), "x_a", CALCULATE(COUNTROWS('Supply Chain'), 'Supply Chain'[Stock Status] = "Critical"), "x_b", CALCULATE(COUNTROWS('Supply Chain'), 'Supply Chain'[Stock Status] = "Reorder"), "x_c", CALCULATE(COUNTROWS('Supply Chain'), 'Supply Chain'[Stock Status] = "Healthy"))
			VAR _s2 = ADDCOLUMNS(_s, "x_n", [x_a] + [x_b] + [x_c], "x_s", DIVIDE([x_a], [x_a] + [x_b] + [x_c], 0))
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Stock health by location" & "</div><div class='sub'>" & "sorted by share of critical SKUs" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='list'><div class='keys' style='margin-bottom:4px'><span><i class='sw' style='background:var(--risk)'></i>✕ Critical (≤ 10)</span><span><i class='sw' style='background:var(--warn)'></i>! Below order qty</span><span><i class='sw' style='background:var(--good)'></i>✓ Healthy</span><span style='margin-left:auto'>SKUs</span></div>" & CONCATENATEX(_s2, "<div class='hb big' style='grid-template-columns:84px 1fr 52px'><div class='nm'>" & 'Location'[City] & "</div><div class='tr' style='height:24px'><div class='st' style='width:100%;--d:" & FORMAT(RANKX(_s2, [x_s], , DESC) * 0.08, "0.00", "en-US") & "s'><i class='r' style='flex:" & FORMAT([x_a], "0", "en-US") & "' title='" & 'Location'[City] & " · Critical · " & FORMAT([x_a], "0", "en-US") & " SKUs'><em>" & IF(DIVIDE([x_a], [x_a] + [x_b] + [x_c], 0) >= 0.08, "✕ " & FORMAT([x_a], "0", "en-US"), "") & "</em></i><i class='w' style='flex:" & FORMAT([x_b], "0", "en-US") & "' title='" & 'Location'[City] & " · Below order qty · " & FORMAT([x_b], "0", "en-US") & " SKUs'><em>" & IF(DIVIDE([x_b], [x_a] + [x_b] + [x_c], 0) >= 0.08, "! " & FORMAT([x_b], "0", "en-US"), "") & "</em></i><i class='g' style='flex:" & FORMAT([x_c], "0", "en-US") & "' title='" & 'Location'[City] & " · Healthy · " & FORMAT([x_c], "0", "en-US") & " SKUs'><em>" & IF(DIVIDE([x_c], [x_a] + [x_b] + [x_c], 0) >= 0.08, "✓ " & FORMAT([x_c], "0", "en-US"), "") & "</em></i></div></div><div class='vl'>" & FORMAT([x_n], "0", "en-US") & "</div></div>", "", [x_s], DESC, [x_n], DESC) & "</div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: 12ba91d7-fdd9-467c-8d33-08a182b1ee05

	/// HTML for the Critical SKU Queue visual. Bind it to the HTML Content custom visual.
	measure 'HTML Critical SKU Queue' =
			VAR _n = [# SKUs]
			VAR _q = TOPN(8, FILTER('Supply Chain', 'Supply Chain'[Stock Level] < 'Supply Chain'[Order Quantity]), 'Supply Chain'[Stock Level], ASC, 'Supply Chain'[Supplier Lead Time], DESC)
			RETURN
			IF(_n = 0, [HTML Empty], [HTML Head] & "<div class='card'><div class='hd'><div class='ttl'>" & "Replenish first" & "</div><div class='sub'>" & "lowest stock, then longest supplier lead time" & "</div><div class='inf'>i</div></div><div class='body'>" & "<div class='col'><table class='tb tight'><tr><th>SKU</th><th>Location</th><th>Stock / order</th><th>Status</th><th>Lead</th></tr>" & CONCATENATEX(_q, "<tr style='--d:" & FORMAT(RANKX(_q, 'Supply Chain'[Stock Level], , ASC) * 0.07, "0.00", "en-US") & "s'><td>" & RELATED('Product'[SKU]) & "</td><td>" & RELATED('Location'[City]) & "</td><td><div class='bt'><i style='--ac:var(--" & IF('Supply Chain'[Stock Status] = "Critical", "risk", "defect") & ");--on:var(--on_" & IF('Supply Chain'[Stock Status] = "Critical", "risk", "defect") & ");width:" & FORMAT(MIN(100, DIVIDE('Supply Chain'[Stock Level], 'Supply Chain'[Order Quantity], 0) * 100), "0", "en-US") & "%;--d:" & FORMAT(RANKX(_q, 'Supply Chain'[Stock Level], , ASC) * 0.07, "0.00", "en-US") & "s' title='" & RELATED('Product'[SKU]) & " · stock " & 'Supply Chain'[Stock Level] & " of order quantity " & 'Supply Chain'[Order Quantity] & "'>" & 'Supply Chain'[Stock Level] & " / " & 'Supply Chain'[Order Quantity] & "</i></div></td><td><span class='pill " & IF('Supply Chain'[Stock Status] = "Critical", "p-fail", "p-pend") & "'>" & IF('Supply Chain'[Stock Status] = "Critical", "✕", "!") & " " & IF('Supply Chain'[Stock Status] = "Critical", "Critical", "Reorder") & "</span></td><td>" & 'Supply Chain'[Supplier Lead Time] & " d</td></tr>", "", 'Supply Chain'[Stock Level], ASC, 'Supply Chain'[Supplier Lead Time], DESC) & "</table></div>" & "</div></div>")
		displayFolder: Visuals
		lineageTag: d48b3eb5-71fc-4e0b-a4cb-cf8eb520ebf1

	column Placeholder
		lineageTag: bedc386f-3df4-4c8f-880e-63ce7b318a84
		isNameInferred
		sourceColumn: [Placeholder]

	partition 'HTML Visuals' = calculated
		mode: import
		source = ROW("Placeholder", 1)

